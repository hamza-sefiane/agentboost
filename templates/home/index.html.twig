{% extends 'base.html.twig' %}

{% block title %}
	{{ 'home.meta.title'|trans }}
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{% block javascripts %}
	 <script type="module" src="{{ asset('js/home.js') }}"></script>
{% endblock %}

{% block body %}

	<section class="home-hero">
		<div class="hero-grid">
			<div>
				<div class="hero-kicker">
					<span>●</span>
					{{ 'home.hero.kicker'|trans }}
				</div>

				<h1 class="hero-title">
					{{ 'home.hero.title_line_1'|trans }}
					<br>
					{{ 'home.hero.title_line_2'|trans }}
				</h1>

				<p class="hero-text">
					{{ 'home.hero.text'|trans }}
				</p>

				<div class="hero-actions">
					{% if is_granted('ACCESS_DASHBOARD') %}
						<a href="{{ path('dashboard') }}" class="hero-btn-primary">
							{{ 'home.actions.open_dashboard'|trans }}
						</a>
					{% elseif app.user %}
						<a href="{{ path('pricing') }}" class="hero-btn-primary">
							{{ 'home.actions.choose_access'|trans }}
						</a>
					{% else %}
						<a href="{{ path('app_register') }}" class="hero-btn-primary">
							{{ 'home.actions.create_estimation'|trans }}
						</a>
					{% endif %}

					<a href="{{ path('pricing') }}" class="hero-btn-secondary">
						{{ 'home.actions.view_offers'|trans }}
					</a>
				</div>

				<div class="hero-note">
					{{ 'home.hero.note'|trans }}
				</div>
			</div>

			<div class="product-preview">
				<div class="preview-window">
					<div class="preview-topbar">
						<span class="preview-dot"></span>
						<span class="preview-dot"></span>
						<span class="preview-dot"></span>
					</div>

					<div class="preview-body">
						<div class="preview-stat-grid">
							<div class="preview-stat">
								<strong>12</strong>
								<span>{{ 'home.preview.estimations'|trans }}</span>
							</div>

							<div class="preview-stat">
								<strong>8</strong>
								<span>{{ 'home.preview.listings'|trans }}</span>
							</div>

							<div class="preview-stat">
								<strong>5</strong>
								<span>{{ 'home.preview.pdf_ready'|trans }}</span>
							</div>
						</div>

						<div class="preview-card">
							<div class="preview-card-head">
								<span class="preview-badge">{{ 'home.preview.apartment'|trans }}</span>
								<span class="preview-price">312 000 €</span>
							</div>

							<div class="preview-line"></div>
							<div class="preview-line short"></div>
							<div class="preview-line"></div>

							<div class="preview-actions">
								<div class="preview-action primary">
									{{ 'home.preview.generate_listing'|trans }}
								</div>

								<div class="preview-action secondary">
									{{ 'home.preview.pdf_estimation'|trans }}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section-soft">
		<div class="feature-grid">
			<div class="feature-card">
				<div class="feature-icon">🏡</div>
				<h3>{{ 'home.features.estimation.title'|trans }}</h3>
				<p>{{ 'home.features.estimation.text'|trans }}</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">✍️</div>
				<h3>{{ 'home.features.listings.title'|trans }}</h3>
				<p>{{ 'home.features.listings.text'|trans }}</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">📄</div>
				<h3>{{ 'home.features.pdf.title'|trans }}</h3>
				<p>{{ 'home.features.pdf.text'|trans }}</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">📊</div>
				<h3>{{ 'home.features.dashboard.title'|trans }}</h3>
				<p>{{ 'home.features.dashboard.text'|trans }}</p>
			</div>
		</div>
	</section>

	<section class="workflow-section">
		<div>
			<h2 class="section-title">
				{{ 'home.workflow.title'|trans }}
			</h2>

			<p class="section-text">
				{{ 'home.workflow.text'|trans }}
			</p>
		</div>

		<div class="workflow-grid">
			<div class="workflow-step">
				<span>1</span>
				<h3>{{ 'home.workflow.step_1.title'|trans }}</h3>
				<p>{{ 'home.workflow.step_1.text'|trans }}</p>
			</div>

			<div class="workflow-step">
				<span>2</span>
				<h3>{{ 'home.workflow.step_2.title'|trans }}</h3>
				<p>{{ 'home.workflow.step_2.text'|trans }}</p>
			</div>

			<div class="workflow-step">
				<span>3</span>
				<h3>{{ 'home.workflow.step_3.title'|trans }}</h3>
				<p>{{ 'home.workflow.step_3.text'|trans }}</p>
			</div>
		</div>
	</section>

	<section class="final-cta">
		<div class="final-cta-card">
			<h2>
				{{ 'home.final_cta.title_line_1'|trans }}
				<br>
				{{ 'home.final_cta.title_line_2'|trans }}
			</h2>

			<p>
				{{ 'home.final_cta.text'|trans }}
			</p>

			{% if is_granted('ACCESS_DASHBOARD') %}
				<a href="{{ path('dashboard') }}" class="hero-btn-primary">
					{{ 'home.actions.access_dashboard'|trans }}
				</a>
			{% elseif app.user %}
				<a href="{{ path('pricing') }}" class="hero-btn-primary">
					{{ 'home.actions.choose_access'|trans }}
				</a>
			{% else %}
				<a href="{{ path('app_register') }}" class="hero-btn-primary">
					{{ 'home.actions.create_estimation'|trans }}
				</a>
			{% endif %}
		</div>
	</section>

{% endblock %}
