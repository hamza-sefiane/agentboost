{% extends 'base.html.twig' %}

{% block title %}Notifications
{% endblock %}

{% block body %}
	<div class="container py-4">

		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="h3 fw-bold mb-0">
				Notifications
			</h1>

			{% if notifications|length > 0 %}
				<form method="post" action="{{ path('notifications_read_all') }}">
					<input type="hidden" name="_token" value="{{ csrf_token('notifications_read_all') }}">

					<button type="submit" class="btn btn-outline-success">
						Tout marquer comme lu
					</button>
				</form>
			{% endif %}
		</div>

		{% if notifications is empty %}
			<div class="card border-0 shadow-sm rounded-4">
				<div class="card-body p-4 text-center">
					<h5 class="fw-bold mb-2">
						Aucune notification
					</h5>

					<p class="text-muted mb-0">
						Vous n'avez aucune notification pour le moment.
					</p>
				</div>
			</div>
		{% else %}
			<div class="d-flex flex-column gap-3">
				{% for notification in notifications %}
					<div class="card border-0 shadow-sm rounded-4">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-start gap-3 mb-2">
								<div>
									<h5 class="fw-bold mb-1">
										{{ notification.title }}
									</h5>

									<div class="text-muted small">
										{{ notification.createdAt|date('d/m/Y H:i') }}
									</div>
								</div>

								<div class="d-flex align-items-center gap-2">
									{% if not notification.isRead %}
										<span class="badge bg-success">
											Nouveau
										</span>
									{% endif %}

									<form method="post" action="{{ path('notifications_delete', { id: notification.id }) }}" onsubmit="return confirm('Supprimer cette notification ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete_notification_' ~ notification.id) }}">

										<button type="submit" class="btn btn-sm btn-outline-danger">
											Supprimer
										</button>
									</form>
								</div>
							</div>

							<p class="mb-0">
								{{ notification.message }}
							</p>
						</div>
					</div>
				{% endfor %}
			</div>
		{% endif %}

	</div>
{% endblock %}
