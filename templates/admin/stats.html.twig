{% extends 'base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block title %}
	{{ 'stats.meta.title'|trans }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	 <script type="module" src="{{ asset('js/admin.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="container py-4">

		<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
			<h1 class="mb-0">
				{{ 'stats.title'|trans }}
			</h1>

			<div class="d-flex gap-2">
				<a href="{{ path('admin_users') }}" class="btn btn-outline-primary">
					Users
				</a>

				<a href="{{ path('admin_logs') }}" class="btn btn-outline-dark">
					Logs admin
				</a>
			</div>
		</div>

	</div>

	<div class="admin-stats-page">

		<div class="admin-stats-grid">
			<div class="admin-card">
				<span>{{ 'stats.cards.users'|trans }}</span>
				<strong>{{ stats.users }}</strong>
			</div>

			<div class="admin-card">
				<span>{{ 'stats.cards.active_subscriptions'|trans }}</span>
				<strong>{{ stats.activeSubscriptions }}</strong>
			</div>

			<div class="admin-card">
				<span>{{ 'stats.cards.properties'|trans }}</span>
				<strong>{{ stats.properties }}</strong>
			</div>

			<div class="admin-card">
				<span>{{ 'stats.cards.estimated_revenue'|trans }}</span>
				<strong>{{ stats.estimatedRevenue }}
					€</strong>
			</div>

			<div class="admin-card">
				<span>{{ 'stats.cards.conversion_rate'|trans }}</span>
				<strong>{{ stats.conversionRate }}%</strong>
			</div>

			<div class="admin-card">
				<span>{{ 'stats.cards.free_users'|trans }}</span>
				<strong>{{ stats.freeUsers }}</strong>
			</div>
		</div>

		<div class="admin-charts-grid">
			<div class="admin-chart-card">
				<h2>{{ 'stats.charts.users_split'|trans }}</h2>

				<div class="admin-chart-wrapper">
					<canvas id="usersPieChart"></canvas>
				</div>
			</div>

			<div class="admin-chart-card">
				<h2>{{ 'stats.charts.global_view'|trans }}</h2>

				<div class="admin-chart-wrapper">
					<canvas id="globalBarChart"></canvas>
				</div>
			</div>

			<div class="admin-chart-card">
				<h2>{{ 'stats.charts.top_cities'|trans }}</h2>

				<div class="admin-chart-wrapper">
					<canvas id="citiesChart"></canvas>
				</div>
			</div>
		</div>

		<div class="admin-tables-grid">
			<div class="admin-table-card">
				<h2>{{ 'stats.tables.latest_users'|trans }}</h2>

				<table>
					<thead>
						<tr>
							<th>{{ 'stats.tables.email'|trans }}</th>
							<th>{{ 'stats.tables.status'|trans }}</th>
							<th>{{ 'stats.tables.plan'|trans }}</th>
						</tr>
					</thead>

					<tbody>
						{% for user in latestUsers %}
							<tr>
								<td>{{ user.email }}</td>
								<td>{{ user.subscription_status }}</td>
								<td>{{ user.current_plan }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="3">
									{{ 'stats.empty.users'|trans }}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<div class="admin-table-card">
				<h2>{{ 'stats.tables.latest_stripe_events'|trans }}</h2>

				<table>
					<thead>
						<tr>
							<th>{{ 'stats.tables.event'|trans }}</th>
							<th>{{ 'stats.tables.date'|trans }}</th>
						</tr>
					</thead>

					<tbody>
						{% for event in latestStripeEvents %}
							<tr>
								<td>{{ event.event_id }}</td>
								<td>{{ event.created_at }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="2">
									{{ 'stats.empty.stripe_events'|trans }}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

	</div>

	 <script type="application/json" id="admin-stats-data">
			{{ stats|json_encode|raw }}
		</script>

	 <script type="application/json" id="admin-cities-data">
			{{ topCities|json_encode|raw }}
		</script>
{% endblock %}
