{% extends 'base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block title %}
	{{ 'users.meta.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container py-5">

		<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
			<h1 class="mb-0">
				{{ 'users.title'|trans }}
			</h1>

			<div class="d-flex gap-2">
				<a href="{{ path('admin_logs') }}" class="btn btn-outline-dark">
					Logs admin
				</a>

				<a href="{{ path('admin_stats') }}" class="btn btn-outline-secondary">
					{{ 'users.dashboard'|trans }}
				</a>
			</div>
		</div>

		<form method="get" action="{{ path('admin_users') }}" class="row g-2 mb-3">
			<div class="col-md-5">
				<input type="search" name="q" value="{{ search }}" class="form-control" placeholder="{{ 'users.search.placeholder'|trans }}">
			</div>

			<div class="col-md-3">
				<select name="status" class="form-select">
					<option value="">{{ 'users.filters.all'|trans }}</option>
					<option value="active" {{ status == 'active' ? 'selected' : '' }}>active</option>
					<option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>inactive</option>
					<option value="grace" {{ status == 'grace' ? 'selected' : '' }}>grace</option>
				</select>
			</div>

			<div class="col-md-auto">
				<button type="submit" class="btn btn-success">
					{{ 'users.search.button'|trans }}
				</button>
			</div>

			{% if search or status %}
				<div class="col-md-auto">
					<a href="{{ path('admin_users') }}" class="btn btn-outline-secondary">
						{{ 'users.search.reset'|trans }}
					</a>
				</div>
			{% endif %}
		</form>

		<p class="text-muted mb-4">
			{{ 'users.total'|trans({ '%count%': totalUsers }) }}
		</p>

		<div class="table-responsive">
			<table class="table table-bordered align-middle">
				<thead class="table-light">
					<tr>
						<th>{{ 'users.table.id'|trans }}</th>
						<th>{{ 'users.table.email'|trans }}</th>
						<th>{{ 'users.table.plan'|trans }}</th>
						<th>{{ 'users.table.subscription'|trans }}</th>
						<th>{{ 'users.table.verified'|trans }}</th>
						<th>{{ 'users.table.active'|trans }}</th>
						<th>{{ 'users.table.next_billing'|trans }}</th>
						<th>{{ 'users.table.created'|trans }}</th>
						<th>{{ 'users.table.actions'|trans }}</th>
					</tr>
				</thead>

				<tbody>
					{% for user in users %}
						<tr>
							<td>{{ user.id }}</td>
							<td>{{ user.email }}</td>
							<td>{{ user.current_plan ?: '—' }}</td>

							<td>
								<span class="badge bg-{{ user.subscription_status == 'active' ? 'success' : (user.subscription_status == 'grace' ? 'warning' : 'secondary') }}">
									{{ user.subscription_status }}
								</span>
							</td>

							<td>
								{% if user.is_verified %}
									<span class="badge bg-success">{{ 'users.status.yes'|trans }}</span>
								{% else %}
									<span class="badge bg-danger">{{ 'users.status.no'|trans }}</span>
								{% endif %}
							</td>

							<td>
								{% if user.next_billing_date %}
									<span class="badge bg-success">{{ 'users.status.active'|trans }}</span>
								{% else %}
									<span class="badge bg-danger">{{ 'users.status.inactive'|trans }}</span>
								{% endif %}
							</td>

							<td>
								{% if user.next_billing_date %}
									{{ user.next_billing_date|date('d/m/Y H:i') }}
								{% else %}
									—
								{% endif %}
							</td>

							<td>{{ user.created_at|date('d/m/Y H:i') }}</td>

							<td>
								<div class="d-flex gap-2">
									<a href="{{ path('admin_user_show', { id: user.id }) }}" class="btn btn-sm btn-outline-primary">
										{{ 'users.actions.show'|trans }}
									</a>

									<a href="{{ path('admin_user_show', { id: user.id }) }}" class="btn btn-sm btn-outline-dark">
										{{ 'users.actions.manage'|trans }}
									</a>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="9" class="text-center text-muted py-4">
								{{ 'users.empty'|trans }}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

		{% if totalPages > 1 %}
			<nav class="mt-4">
				<ul class="pagination">
					<li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
						<a class="page-link" href="{{ path('admin_users', { q: search, status: status, page: page - 1 }) }}">
							{{ 'users.pagination.previous'|trans }}
						</a>
					</li>

					{% for i in 1..totalPages %}
						<li class="page-item {{ i == page ? 'active' : '' }}">
							<a class="page-link" href="{{ path('admin_users', { q: search, status: status, page: i }) }}">
								{{ i }}
							</a>
						</li>
					{% endfor %}

					<li class="page-item {{ page >= totalPages ? 'disabled' : '' }}">
						<a class="page-link" href="{{ path('admin_users', { q: search, status: status, page: page + 1 }) }}">
							{{ 'users.pagination.next'|trans }}
						</a>
					</li>
				</ul>
			</nav>
		{% endif %}

	</div>
{% endblock %}
