{% extends 'base.html.twig' %}

{% trans_default_domain 'admin' %}

{% block title %}
	{{ 'logs.meta.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container py-5">

		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1>{{ 'logs.title'|trans }}</h1>

			<a href="{{ path('admin_stats') }}" class="btn btn-outline-secondary">
				{{ 'logs.back'|trans }}
			</a>
		</div>

		<div class="table-responsive">
			<table class="table table-bordered align-middle">
				<thead class="table-light">
					<tr>
						<th>{{ 'logs.table.id'|trans }}</th>
						<th>{{ 'logs.table.date'|trans }}</th>
						<th>{{ 'logs.table.actor'|trans }}</th>
						<th>{{ 'logs.table.target_user'|trans }}</th>
						<th>{{ 'logs.table.action'|trans }}</th>
						<th>{{ 'logs.table.ip'|trans }}</th>
					</tr>
				</thead>

				<tbody>
					{% for log in logs %}
						<tr>
							<td>{{ log.id }}</td>
							<td>{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
							<td>{{ log.actorEmail }}</td>
							<td>
								{% if log.targetUser %}
									{{ log.targetUser.email }}
								{% else %}
									—
								{% endif %}
							</td>
							<td>{{ log.event }}</td>
							<td>{{ log.ipAddress ?: '—' }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6" class="text-center text-muted py-4">
								{{ 'logs.empty'|trans }}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>

	</div>
{% endblock %}
