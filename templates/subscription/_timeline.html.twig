<ul
	class="list-group">

	{# ÉTAPE 1 — ACTIVATION #}
	<li class="list-group-item d-flex justify-content-between">
		<span>
			{{ 'subscription.active'|trans }}
		</span>

		<span class="badge bg-success">✔</span>
	</li>

	{# ÉTAPE 2 — CHANGEMENT DE PLAN #}
	{% if app.user.pendingPlan %}
		<li class="list-group-item d-flex justify-content-between">

			<span>
				{{ 'subscription.switching_to'|trans }}

				<strong>
					{{
                        app.user.pendingPlan == 'yearly'
                            ? 'subscription.yearly'|trans
                            : 'subscription.monthly'|trans
                    }}
				</strong>

				{{ 'subscription.next_renewal'|trans }}
			</span>

			<span class="badge bg-warning">⏳</span>
		</li>
	{% endif %}

	{# ÉTAPE 3 — RÉSILIATION PROGRAMMÉE #}
	{% if app.user.subscriptionStatus == 'grace' %}
		<li class="list-group-item d-flex justify-content-between">

			<span>
				{{ 'subscription.cancel_scheduled'|trans }}

				{{ app.user.nextBillingDate|date('d/m/Y') }}
			</span>

			<span class="badge bg-danger">⚠</span>
		</li>
	{% endif %}

	{# ÉTAPE 4 — FIN D’ACCÈS #}
	{% if app.user.subscriptionStatus == 'inactive' %}
		<li class="list-group-item d-flex justify-content-between">

			<span>
				{{ 'subscription.ended'|trans }}
			</span>

			<span class="badge bg-secondary">✖</span>
		</li>
	{% endif %}

</ul>
