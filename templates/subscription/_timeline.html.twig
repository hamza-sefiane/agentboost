<ul class="list-group">

	<li class="list-group-item d-flex justify-content-between">
		<span>
			{{ 'timeline.active'|trans({}, 'subscription') }}
		</span>

		<span class="badge bg-success">✔</span>
	</li>

	{% if app.user.pendingPlan %}
		<li class="list-group-item d-flex justify-content-between">
			<span>
				{{ 'timeline.switching_to'|trans({}, 'subscription') }}

				<strong>
					{{
                        app.user.pendingPlan == 'yearly'
                            ? 'yearly'|trans({}, 'subscription')
                            : 'monthly'|trans({}, 'subscription')
                    }}
				</strong>

				{{ 'timeline.next_renewal'|trans({}, 'subscription') }}
			</span>

			<span class="badge bg-warning">⏳</span>
		</li>
	{% endif %}

	{% if app.user.subscriptionStatus == 'grace' %}
		<li class="list-group-item d-flex justify-content-between">
			<span>
				{{ 'timeline.cancel_scheduled'|trans({}, 'subscription') }}
				{{ app.user.nextBillingDate|date('d/m/Y') }}
			</span>

			<span class="badge bg-danger">⚠</span>
		</li>
	{% endif %}

	{% if app.user.subscriptionStatus == 'inactive' %}
		<li class="list-group-item d-flex justify-content-between">
			<span>
				{{ 'timeline.ended'|trans({}, 'subscription') }}
			</span>

			<span class="badge bg-secondary">✖</span>
		</li>
	{% endif %}

</ul>
