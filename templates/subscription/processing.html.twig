{% extends 'base.html.twig' %}

{% block title %}
	{{ 'payment.success.meta.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container" style="max-width: 600px; margin: 4rem auto; text-align: center;">

		<h1>
			{{ 'payment.success.title'|trans }}
		</h1>

		<p style="margin-top: 1.5rem;">
			{{ 'payment.success.text.line_1'|trans }}<br>
			{{ 'payment.success.text.line_2'|trans }}
		</p>

		<p style="margin-top: 1rem; color: #666;">
			{{ 'payment.success.text.line_3'|trans }}
		</p>

		<div class="spinner-border text-success mt-4" role="status">
			<span class="visually-hidden">
				{{ 'payment.success.loading'|trans }}
			</span>
		</div>

		<div id="continue-wrapper" style="display:none; margin-top: 2.5rem;">
			<a href="{{ path('dashboard') }}" class="btn btn-success btn-lg">
				{{ 'payment.success.actions.dashboard'|trans }}
			</a>
		</div>

		<p style="margin-top: 1.5rem; font-size: 0.9rem; color: #999;">
			{{ 'payment.success.text.line_4'|trans }}
		</p>
	</div>

	 <script>
			(async () => {
				for (let i = 0; i < 5; i++) {
					const res = await fetch('/subscription/sync', {
						method: 'POST'
					});
	
					const data = await res.json();
	
					if (data.ok) {
						window.location.href = '/dashboard';
						return;
					}
	
					await new Promise((resolve) => setTimeout(resolve, 2000));
				}
			})();
		</script>

	 <script>
			setTimeout(() => {
				document.getElementById('continue-wrapper').style.display = 'block';
			}, 3000);
		</script>
{% endblock %}
