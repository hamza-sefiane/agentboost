{% extends 'base.html.twig' %}

{% block title %}Souscription – AgentBoost{% endblock %}

{% block body %}
<div class="container" style="max-width: 600px; margin: 80px auto; text-align: center;">

    <h1 class="mb-3">Activer mon abonnement</h1>

    <p class="lead mb-4">
        Vous avez choisi la formule
        <strong>{{ plan == 'monthly' ? 'mensuelle' : 'annuelle' }}</strong>.
    </p>

    <button
        id="checkout-button"
        class="btn btn-success btn-lg px-5"
    >
        Procéder au paiement sécurisé
    </button>

    <p class="text-muted mt-3">
        Paiement sécurisé via Stripe • Résiliable à tout moment
    </p>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    // Initialisation Stripe
    const stripe = Stripe('{{ stripe_public_key }}');
    const button = document.getElementById('checkout-button');

    // URL calculée UNE FOIS côté Twig (clé de la robustesse)
    const checkoutUrl = "{{ path('create_checkout_session', { plan: plan }) }}";

    button.addEventListener('click', async () => {
        try {
            const response = await fetch(checkoutUrl, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) {
                const text = await response.text();
                console.error('Checkout error', response.status, text);
                alert('Erreur serveur lors de la création du paiement.');
                return;
            }

            const data = await response.json();

            if (!data.id) {
                alert(data.error ?? 'Erreur lors de la création de la session de paiement.');
                return;
            }

            await stripe.redirectToCheckout({ sessionId: data.id });

        } catch (e) {
            console.error(e);
            alert('Une erreur est survenue.');
        }
    });
</script>
{% endblock %}
