{% extends 'base.html.twig' %}

{% block title %}
	{{ 'subscription_checkout.meta.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container" style="max-width: 600px; margin: 80px auto; text-align: center;">

		<h1 class="mb-3">
			{{ 'subscription_checkout.title'|trans }}
		</h1>

		<p class="lead mb-4">
			{{ 'subscription_checkout.selected_plan'|trans }}

			<strong>
				{{ plan == 'monthly'
					? 'subscription.monthly'|trans
					: 'subscription.yearly'|trans
				}}
			</strong>.
		</p>

		<button id="checkout-button" class="btn btn-success btn-lg px-5">
			{{ 'subscription_checkout.button'|trans }}
		</button>

		<p class="text-muted mt-3">
			{{ 'subscription_checkout.footer'|trans }}
		</p>
	</div>

	 <script src="https://js.stripe.com/v3/"></script>

	 <script>
			const stripe = Stripe('{{ stripe_public_key }}');
			const button = document.getElementById('checkout-button');
			const checkoutUrl = "{{ path('create_checkout_session', { plan: plan }) }}";
	
			button.addEventListener('click', async () => {
				try {
					const response = await fetch(checkoutUrl, {
						method: 'POST',
						headers: {
							'Accept': 'application/json',
							'X-CSRF-TOKEN': '{{ csrf_token('create_checkout_session_' ~ plan) }}'
						}
					});
	
					if (!response.ok) {
						const text = await response.text();
						console.error('Checkout error', response.status, text);
						alert('{{ 'subscription_checkout.errors.server'|trans }}');
						return;
					}
	
					const data = await response.json();
	
					if (!data.id) {
						alert(data.error ?? '{{ 'subscription_checkout.errors.session'|trans }}');
						return;
					}
	
					await stripe.redirectToCheckout({ sessionId: data.id });
				} catch (error) {
					console.error(error);
					alert('{{ 'subscription_checkout.errors.generic'|trans }}');
				}
			});
		</script>
{% endblock %}
