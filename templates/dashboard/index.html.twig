{% extends 'base.html.twig' %}

{% block title %}Dashboard – AgentBoost
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/property-create.css') }}">
	<link rel="stylesheet" href="{{ asset('styles/property-list.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script type="module" src="{{ asset('js/property-create.js') }}"></script>
	 <script type="module" src="{{ asset('js/property-list.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="dashboard-page">
		<div class="dashboard-top">
			<div class="dashboard-heading">
				<div class="dashboard-icon">↯</div>
				<div>
					<h1 class="dashboard-title">Nouvelle estimation</h1>
					<p class="dashboard-subtitle">
						Créez une estimation immobilière rapide et exploitable grâce à AgentBoost.
					</p>
				</div>
			</div>

			<a href="{{ path('home') }}" class="help-btn">
				Besoin d’aide ?
			</a>
		</div>


		<div class="stats-grid">
			<div class="stat-card">
				<div class="stat-icon">🏠</div>
				<div>
					<div class="stat-value">{{ properties|length }}</div>
					<div class="stat-label">Biens estimés</div>
					<div class="stat-note">Total actuel</div>
				</div>
			</div>

			<div class="stat-card usage-card">
				<div class="stat-icon">📈</div>
				<div style="width: 100%;">
					{% if usage.isPremium %}
						<div class="stat-value">∞</div>
						<div class="stat-label">Estimations</div>
						<div class="stat-note">Illimitées avec votre offre</div>
					{% else %}
						<div class="stat-value">{{ usage.estimationsUsed }}/{{ usage.estimationsLimit }}</div>
						<div class="stat-label">Estimations gratuites</div>
						<div class="stat-note">{{ usage.estimationsRemaining }}
							restante(s)</div>
						<div class="usage-progress">
							<div class="usage-progress-fill" style="width: {{ min(100, (usage.estimationsUsed / usage.estimationsLimit * 100)|round) }}%;"></div>
						</div>
					{% endif %}
				</div>
			</div>

			<div class="stat-card usage-card">
				<div class="stat-icon">✍️</div>
				<div style="width: 100%;">
					{% if usage.isPremium %}
						<div class="stat-value">∞</div>
						<div class="stat-label">Annonces IA</div>
						<div class="stat-note">Illimitées avec votre offre</div>
					{% else %}
						<div class="stat-value">{{ usage.aiUsed }}/{{ usage.aiLimit }}</div>
						<div class="stat-label">Annonce IA gratuite</div>
						<div class="stat-note">{{ usage.aiRemaining }}
							restante(s)</div>
						<div class="usage-progress">
							<div class="usage-progress-fill" style="width: {{ min(100, (usage.aiUsed / usage.aiLimit * 100)|round) }}%;"></div>
						</div>
					{% endif %}
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon">⭐</div>
				<div>
					<div class="stat-value">
						{% if usage.isPremium %}
							Pro
						{% else %}
							Free
						{% endif %}
					</div>
					<div class="stat-label">Offre actuelle</div>
					<div class="stat-note">
						{% if usage.isPremium %}
							Accès premium actif
						{% else %}
							<a href="{{ path('pricing') }}" class="usage-upgrade">Passer premium</a>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="dashboard-card">
			<form method="post" action="{{ path('dashboard') }}" enctype="multipart/form-data">
				<div class="form-layout">
					<div>
						<div class="form-section-title">Informations du bien</div>

						<div class="row g-3">
							<div class="col-md-4">
								<label class="field-label" for="property-type">Type de bien</label>
								<select name="type" id="property-type" class="form-select" required>
									<option value="Appartement">Appartement</option>
									<option value="Maison">Maison</option>
									<option value="Terrain">Terrain</option>
									<option value="Parking">Parking</option>
								</select>
							</div>

							<div class="col-md-5 address-autocomplete-wrapper">
								<label class="field-label" for="address-input">Adresse du bien</label>
								<input name="address" id="address-input" type="text" class="form-control" placeholder="Adresse complète" maxlength="255" autocomplete="off">
								<div id="address-results" class="address-results"></div>
							</div>

							<div class="col-md-3">
								<label class="field-label" for="postal-code-input">Code postal</label>
								<input name="postalCode" id="postal-code-input" type="text" class="form-control" placeholder="Code postal" maxlength="5" pattern="[0-9]{5}" inputmode="numeric" required>
							</div>

							<div class="col-md-4">
								<label class="field-label" for="city-input">Ville</label>
								<input name="city" id="city-input" class="form-control" placeholder="Ville" required>
							</div>

							<div class="col-md-4">
								<label class="field-label">Surface (m²)</label>
								<input name="surface" type="number" min="1" class="form-control" placeholder="Ex : 72" required>
							</div>

							<div class="col-md-4" id="rooms-wrapper">
								<label class="field-label" for="rooms-input">Nombre de pièces</label>
								<input name="rooms" id="rooms-input" type="number" min="1" class="form-control" placeholder="Ex : 3">
							</div>

							<div class="col-md-4" id="parking-wrapper">
								<label class="field-label" for="parking-input">Parking</label>
								<select name="parking" id="parking-input" class="form-select">
									<option value="0">Sans parking</option>
									<option value="1">Avec parking</option>
								</select>
							</div>

							<div class="col-12">
								<label class="field-label">Détails supplémentaires
									<span class="text-muted fw-normal">(optionnel)</span>
								</label>
								<textarea name="extraDetails" class="form-control" rows="2" placeholder="Ex : balcon, vue dégagée, cuisine équipée, proche gare, lumineux..."></textarea>
							</div>

							<div class="col-12">
								<label class="field-label">Photos du bien</label>

								<div class="upload-zone">
									<div class="upload-left">
										<div class="upload-icon">🖼️</div>
										<div>
											<div class="upload-title">Déposez vos photos ici</div>
											<div class="upload-text">JPG, PNG, WEBP. Maximum 5 photos.</div>
										</div>
									</div>

									<input type="file" name="photos[]" id="photos-input" class="form-control" accept="image/jpeg,image/png,image/webp" multiple>
								</div>

								<div id="photos-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
							</div>

							<div class="col-12">
								<button type="submit" class="estimate-submit">
									Estimer le bien
								</button>
							</div>
						</div>
					</div>

					<aside class="ai-panel">
						<div class="ai-box">
							<div class="ai-title">↯ Estimation rapide & IA</div>

							<p class="ai-text">
								Obtenez une estimation structurée et des supports exploitables pour vos clients.
							</p>

							<ul class="ai-list">
								<li>Analyse du marché local</li>
								<li>Estimation claire</li>
								<li>Rapport PDF généré</li>
								<li>Annonce prête à retravailler</li>
							</ul>
						</div>

						<div class="security-box">
							<strong>🔒</strong>
							<span>Vos données sont sécurisées et ne sont jamais partagées.</span>
						</div>
					</aside>
				</div>
			</form>
		</div>

		{% if app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'monthly' %}
			<div class="annual-upsell">
				<div class="annual-upsell-content">
					<div class="annual-upsell-icon">↗</div>
					<div>
						<p class="annual-upsell-title">Passez à l’annuel et diffusez plus vite</p>
						<p class="annual-upsell-text">
							Facebook, Leboncoin et PDF Premium inclus pour gagner du temps sur vos annonces.
						</p>
					</div>
				</div>

				<a href="{{ path('subscription_manage') }}" class="annual-upsell-button">
					Passer à l’annuel
				</a>
			</div>
		{% endif %}

		<div class="properties-section" id="properties-section">
			<div class="properties-header">
				<h2>Mes biens estimés</h2>
			</div>

			{% include 'dashboard/_list.html.twig' with { properties: properties } %}
		</div>
	{% endblock %}
