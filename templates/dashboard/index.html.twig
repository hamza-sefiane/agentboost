{% extends 'base.html.twig' %}

{% block title %}
	{{ 'dashboard.meta.title'|trans({}, 'dashboard') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/property-create.css') }}">
	<link rel="stylesheet" href="{{ asset('styles/property-list.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script type="module" src="{{ asset('js/property-create.js') }}"></script>
	 <script type="module" src="{{ asset('js/property-list.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="dashboard-page">
		<div class="dashboard-top">
			<div class="dashboard-heading">
				<div class="dashboard-icon">↯</div>

				<div>
					<h1 class="dashboard-title">
						{{ 'dashboard.title'|trans({}, 'dashboard') }}
					</h1>

					<p class="dashboard-subtitle">
						{{ 'dashboard.subtitle'|trans({}, 'dashboard') }}
					</p>
				</div>
			</div>

			<a href="{{ path('home') }}" class="help-btn">
				{{ 'dashboard.help'|trans({}, 'dashboard') }}
			</a>
		</div>

		<div class="stats-grid">
			<div class="stat-card">
				<div class="stat-icon">🏠</div>

				<div>
					<div class="stat-value">{{ properties|length }}</div>
					<div class="stat-label">{{ 'dashboard.stats.estimated_properties'|trans({}, 'dashboard') }}</div>
					<div class="stat-note">{{ 'dashboard.stats.current_total'|trans({}, 'dashboard') }}</div>
				</div>
			</div>

			<div class="stat-card usage-card">
				<div class="stat-icon">📈</div>

				<div style="width: 100%;">
					{% if usage.isPremium %}
						<div class="stat-value">∞</div>
						<div class="stat-label">{{ 'dashboard.stats.estimations'|trans({}, 'dashboard') }}</div>
						<div class="stat-note">{{ 'dashboard.stats.unlimited_offer'|trans({}, 'dashboard') }}</div>
					{% else %}
						<div class="stat-value">{{ usage.estimationsUsed }}/{{ usage.estimationsLimit }}</div>
						<div class="stat-label">{{ 'dashboard.stats.free_estimations'|trans({}, 'dashboard') }}</div>

						<div class="stat-note">
							{{ usage.estimationsRemaining }}
							{{ 'dashboard.stats.remaining'|trans({}, 'dashboard') }}
						</div>

						<div class="usage-progress">
							<div class="usage-progress-fill" style="width: {{ min(100, (usage.estimationsUsed / usage.estimationsLimit * 100)|round) }}%;"></div>
						</div>

						{% if not usage.isPremium and usage.estimationsRemaining == 0 %}
							<a href="{{ path('pricing') }}" class="usage-upgrade">
								Débloquer les estimations
							</a>
						{% endif %}
					{% endif %}
				</div>
			</div>

			<div class="stat-card usage-card">
				<div class="stat-icon">✍️</div>

				<div style="width: 100%;">
					{% if usage.isPremium %}
						<div class="stat-value">∞</div>
						<div class="stat-label">{{ 'dashboard.stats.ai_ads'|trans({}, 'dashboard') }}</div>
						<div class="stat-note">{{ 'dashboard.stats.unlimited_offer'|trans({}, 'dashboard') }}</div>
					{% else %}
						<div class="stat-value">{{ usage.aiUsed }}/{{ usage.aiLimit }}</div>
						<div class="stat-label">{{ 'dashboard.stats.free_ai_ad'|trans({}, 'dashboard') }}</div>

						<div class="stat-note">
							{{ usage.aiRemaining }}
							{{ 'dashboard.stats.remaining'|trans({}, 'dashboard') }}
						</div>

						<div class="usage-progress">
							<div class="usage-progress-fill" style="width: {{ min(100, (usage.aiUsed / usage.aiLimit * 100)|round) }}%;"></div>
						</div>

						{% if not usage.isPremium and usage.aiRemaining == 0 %}
							<a href="{{ path('pricing') }}" class="usage-upgrade">
								Débloquer l'IA
							</a>
						{% endif %}
					{% endif %}
				</div>
			</div>

			<div class="stat-card">
				<div class="stat-icon">⭐</div>

				<div>
					<div class="stat-value">
						{% if usage.isPremium %}
							Pro
						{% else %}
							Free
						{% endif %}
					</div>

					<div class="stat-label">{{ 'dashboard.stats.current_offer'|trans({}, 'dashboard') }}</div>

					<div class="stat-note">
						{% if usage.isPremium %}
							{{ 'dashboard.stats.premium_active'|trans({}, 'dashboard') }}
						{% else %}
							<a href="{{ path('pricing') }}" class="usage-upgrade">
								{{ 'dashboard.stats.upgrade'|trans({}, 'dashboard') }}
							</a>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		{% set latestProperty = properties|first %}
		{% set dashboardNotifications = latest_notifications(3) %}

		{% if properties is empty %}
			<div class="dashboard-card mb-4">
				<div class="row g-3 align-items-center">
					<div class="col-lg-5">
						<div class="text-muted small">Démarrage</div>
						<h2 class="h4 mb-2">Bienvenue sur AgentBoost</h2>
						<p class="mb-0 text-muted">
							3 étapes pour obtenir votre première estimation immobilière
						</p>
					</div>

					<div class="col-lg-7">
						<div class="row g-3">
							<div class="col-md-4">
								<div class="border rounded p-3 h-100">
									<div class="fw-semibold">1. Créez votre première estimation</div>
								</div>
							</div>

							<div class="col-md-4">
								<div class="border rounded p-3 h-100">
									<div class="fw-semibold">2. Générez une annonce IA</div>
								</div>
							</div>

							<div class="col-md-4">
								<div class="border rounded p-3 h-100">
									<div class="fw-semibold">3. Téléchargez votre rapport PDF</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		{% endif %}

		{% if latestProperty %}
			<div class="dashboard-card mb-4">
				<div class="row g-3 align-items-center">
					<div class="col-lg-5">
						<div class="text-muted small">Prochaine action</div>
						<h2 class="h5 mb-1">
							Continuez avec {{ latestProperty.type }} à {{ latestProperty.city }}
						</h2>
						<p class="mb-0 text-muted">
							Suivez le tunnel AgentBoost jusqu’au rapport PDF.
						</p>
					</div>

					<div class="col-lg-7">
						<div class="d-flex flex-wrap gap-2 justify-content-lg-end">
							{% if not latestProperty.adText %}
								<form method="post" action="{{ path('property_generate_ad', { id: latestProperty.id }) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('generate_ad_' ~ latestProperty.id) }}">
									<button type="submit" class="btn btn-sm btn-success">
										Générer l’annonce IA
									</button>
								</form>
							{% else %}
								<a href="{{ path('property_pdf', { id: latestProperty.id }) }}" class="btn btn-sm btn-primary">
									Télécharger le PDF
								</a>
							{% endif %}

							{% if app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'yearly' %}
								<a href="{{ path('property_pdf_premium', { id: latestProperty.id }) }}" class="btn btn-sm btn-warning">
									PDF premium
								</a>
							{% else %}
								<a href="{{ path('pricing') }}" class="btn btn-sm btn-outline-warning">
									Passer à l’offre annuelle
								</a>
							{% endif %}
						</div>

						<div class="d-flex flex-wrap gap-3 mt-3 small text-muted justify-content-lg-end">
							<span>1. Estimation créée</span>
							<span>
								2.
								{% if latestProperty.adText %}
									Annonce IA prête
								{% else %}
									Annonce IA à générer
								{% endif %}
							</span>
							<span>3. Rapport PDF</span>
						</div>
					</div>
				</div>
			</div>
		{% endif %}

		<div class="dashboard-card mb-4">
			<div class="row g-3">
				<div class="col-md-3">
					<div class="border rounded p-3 h-100">
						<div class="text-muted small">Abonnement actuel</div>
						<div class="fw-bold fs-5">
							{% if app.user.subscriptionStatus == 'active' %}
								{{ app.user.currentPlan == 'yearly' ? 'Annuel' : 'Mensuel' }}
							{% elseif app.user.subscriptionStatus == 'grace' %}
								Annulation programmée
							{% else %}
								Free
							{% endif %}
						</div>

						<div class="small text-muted mt-2">
							{% if app.user.nextBillingDate %}
								Prochaine échéance :
								{{ app.user.nextBillingDate|date('d/m/Y') }}
							{% else %}
								Aucune échéance active
							{% endif %}
						</div>
					</div>
				</div>

				<div class="col-md-3">
					<div class="border rounded p-3 h-100">
						<div class="text-muted small">Crédits disponibles</div>

						<div class="mt-2">
							<div class="fw-semibold">Estimations</div>
							<div>
								{% if usage.isPremium %}
									Illimitées
								{% else %}
									{{ usage.estimationsRemaining }} restantes
								{% endif %}
							</div>
						</div>

						<div class="mt-2">
							<div class="fw-semibold">Générations IA</div>
							<div>
								{% if usage.isPremium %}
									Illimitées
								{% else %}
									{{ usage.aiRemaining }} restante{{ usage.aiRemaining > 1 ? 's' : '' }}
								{% endif %}
							</div>
						</div>
					</div>
				</div>

				<div class="col-md-3">
					<div class="border rounded p-3 h-100">
						<div class="text-muted small">Dernier bien estimé</div>

						{% if latestProperty %}
							<div class="fw-bold mt-1">
								{{ latestProperty.type }} à {{ latestProperty.city }}
							</div>

							<div class="small text-muted">
								{{ latestProperty.estimate|number_format(0, ',', ' ') }} €
							</div>

							<div class="d-flex flex-wrap gap-2 mt-3">
								<a href="{{ path('property_pdf', { id: latestProperty.id }) }}" class="btn btn-sm btn-outline-primary">
									PDF
								</a>

								{% if app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'yearly' %}
									<a href="{{ path('property_pdf_premium', { id: latestProperty.id }) }}" class="btn btn-sm btn-warning">
										PDF premium
									</a>
								{% endif %}
							</div>
						{% else %}
							<div class="text-muted mt-2">
								Aucune estimation pour le moment.
							</div>
						{% endif %}
					</div>
				</div>

				<div class="col-md-3">
					<div class="border rounded p-3 h-100">
						<div class="text-muted small">Dernières notifications</div>

						{% if dashboardNotifications is empty %}
							<div class="text-muted mt-2">
								Aucune notification.
							</div>
						{% else %}
							<div class="mt-2 d-flex flex-column gap-2">
								{% for notification in dashboardNotifications %}
									<div>
										<div class="fw-semibold small">{{ notification.title }}</div>
										<div class="text-muted small">{{ notification.createdAt|date('d/m/Y H:i') }}</div>
									</div>
								{% endfor %}
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="dashboard-card">
			<form method="post" action="{{ path('dashboard') }}" enctype="multipart/form-data">
				<div class="form-layout">
					<div>
						<div class="form-section-title">
							{{ 'dashboard.form.property_info'|trans({}, 'dashboard') }}
						</div>

						<div class="row g-3">
							<div class="col-md-4">
								<label class="field-label" for="property-type">
									{{ 'dashboard.form.property_type'|trans({}, 'dashboard') }}
								</label>

								<select name="type" id="property-type" class="form-select" required>
									<option value="Appartement">{{ 'dashboard.form.apartment'|trans({}, 'dashboard') }}</option>
									<option value="Maison">{{ 'dashboard.form.house'|trans({}, 'dashboard') }}</option>
									<option value="Terrain">{{ 'dashboard.form.land'|trans({}, 'dashboard') }}</option>
									<option value="Parking">{{ 'dashboard.form.parking'|trans({}, 'dashboard') }}</option>
								</select>
							</div>

							<div class="col-md-5 address-autocomplete-wrapper">
								<label class="field-label" for="address-input">
									{{ 'dashboard.form.address'|trans({}, 'dashboard') }}
								</label>

								<input name="address" id="address-input" type="text" class="form-control" placeholder="{{ 'dashboard.form.full_address'|trans({}, 'dashboard') }}" maxlength="255" autocomplete="off">

								<div id="address-results" class="address-results"></div>
							</div>

							<div class="col-md-3">
								<label class="field-label" for="postal-code-input">
									{{ 'dashboard.form.postal_code'|trans({}, 'dashboard') }}
								</label>

								<input name="postalCode" id="postal-code-input" type="text" class="form-control" placeholder="{{ 'dashboard.form.postal_code'|trans({}, 'dashboard') }}" maxlength="5" pattern="[0-9]{5}" inputmode="numeric" required>
							</div>

							<div class="col-md-4">
								<label class="field-label" for="city-input">
									{{ 'dashboard.form.city'|trans({}, 'dashboard') }}
								</label>

								<input name="city" id="city-input" class="form-control" placeholder="{{ 'dashboard.form.city'|trans({}, 'dashboard') }}" required>
							</div>

							<div class="col-md-4">
								<label class="field-label">
									{{ 'dashboard.form.surface'|trans({}, 'dashboard') }}
								</label>

								<input name="surface" type="number" min="1" class="form-control" placeholder="Ex : 72" required>
							</div>

							<div class="col-md-4" id="rooms-wrapper">
								<label class="field-label" for="rooms-input">
									{{ 'dashboard.form.rooms'|trans({}, 'dashboard') }}
								</label>

								<input name="rooms" id="rooms-input" type="number" min="1" class="form-control" placeholder="Ex : 3">
							</div>

							<div class="col-md-4" id="parking-wrapper">
								<label class="field-label" for="parking-input">
									{{ 'dashboard.form.parking'|trans({}, 'dashboard') }}
								</label>

								<select name="parking" id="parking-input" class="form-select">
									<option value="0">{{ 'dashboard.form.without_parking'|trans({}, 'dashboard') }}</option>
									<option value="1">{{ 'dashboard.form.with_parking'|trans({}, 'dashboard') }}</option>
								</select>
							</div>

							<div class="col-12">
								<label class="field-label">
									{{ 'dashboard.form.extra_details'|trans({}, 'dashboard') }}

									<span class="text-muted fw-normal">
										{{ 'dashboard.form.optional'|trans({}, 'dashboard') }}
									</span>
								</label>

								<textarea name="extraDetails" class="form-control" rows="2" placeholder="{{ 'dashboard.form.extra_placeholder'|trans({}, 'dashboard') }}"></textarea>
							</div>

							<div class="col-12">
								<label class="field-label">
									{{ 'dashboard.form.photos'|trans({}, 'dashboard') }}
								</label>

								<div class="upload-zone">
									<div class="upload-left">
										<div class="upload-icon">🖼️</div>

										<div>
											<div class="upload-title">
												{{ 'dashboard.form.upload_title'|trans({}, 'dashboard') }}
											</div>

											<div class="upload-text">
												{{ 'dashboard.form.upload_text'|trans({}, 'dashboard') }}
											</div>
										</div>
									</div>

									<input type="file" name="photos[]" id="photos-input" class="form-control" accept="image/jpeg,image/png,image/webp" multiple>
								</div>

								<div id="photos-preview" class="d-flex flex-wrap gap-2 mt-3"></div>
							</div>

							<div class="col-12">
								<button type="submit" class="estimate-submit">
									{{ 'dashboard.form.estimate_button'|trans({}, 'dashboard') }}
								</button>
							</div>
						</div>
					</div>

					<aside class="ai-panel">
						<div class="ai-box">
							<div class="ai-title">
								{{ 'dashboard.ai.title'|trans({}, 'dashboard') }}
							</div>

							<p class="ai-text">
								{{ 'dashboard.ai.text'|trans({}, 'dashboard') }}
							</p>

							<ul class="ai-list">
								<li>{{ 'dashboard.ai.market_analysis'|trans({}, 'dashboard') }}</li>
								<li>{{ 'dashboard.ai.clear_estimation'|trans({}, 'dashboard') }}</li>
								<li>{{ 'dashboard.ai.pdf_report'|trans({}, 'dashboard') }}</li>
								<li>{{ 'dashboard.ai.ready_listing'|trans({}, 'dashboard') }}</li>
							</ul>
						</div>

						<div class="security-box">
							<strong>🔒</strong>
							<span>{{ 'dashboard.security.text'|trans({}, 'dashboard') }}</span>
						</div>
					</aside>
				</div>
			</form>
		</div>

		{% if app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'monthly' %}
			<div class="annual-upsell">
				<div class="annual-upsell-content">
					<div class="annual-upsell-icon">↗</div>

					<div>
						<p class="annual-upsell-title">
							{{ 'dashboard.annual.title'|trans({}, 'dashboard') }}
						</p>

						<p class="annual-upsell-text">
							{{ 'dashboard.annual.text'|trans({}, 'dashboard') }}
						</p>
					</div>
				</div>

				<a href="{{ path('subscription_manage') }}" class="annual-upsell-button">
					{{ 'dashboard.annual.button'|trans({}, 'dashboard') }}
				</a>
			</div>
		{% endif %}

		<div class="properties-section" id="properties-section">
			<div class="properties-header">
				<h2>
					{{ 'dashboard.properties.title'|trans({}, 'dashboard') }}
				</h2>
			</div>

			{% include 'dashboard/_list.html.twig' with { properties: properties } %}
		</div>
	</div>
{% endblock %}
