{% set isYearlyPremium = app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'yearly' %}
{% set isMonthlyPremium = app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'monthly' %}

{% if properties is empty %}
    <style>
        .property-empty-state {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 28px;
            padding: 46px 24px;
            text-align: center;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.05);
        }

        .property-empty-icon {
            width: 68px;
            height: 68px;
            border-radius: 22px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 30px;
            font-weight: 900;
        }

        .property-empty-title {
            font-size: 22px;
            font-weight: 950;
            color: #0f172a;
            margin-bottom: 8px;
        }

        .property-empty-text {
            color: #64748b;
            font-size: 15px;
            margin: 0;
        }
    </style>

    <div class="property-empty-state">
        <div class="property-empty-icon">🏠</div>
        <div class="property-empty-title">Aucune estimation pour le moment</div>
        <p class="property-empty-text">Ajoutez votre premier bien pour générer une estimation.</p>
    </div>
{% else %}
    {% set properties = properties|sort((a, b) => b.estimate <=> a.estimate) %}

    <style>
        .property-list-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }

        .property-count {
            color: #64748b;
            font-size: 14px;
            font-weight: 800;
        }

        .bulk-delete-btn {
            border-radius: 999px;
            font-weight: 900;
            padding: 9px 16px;
        }

        .property-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .property-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 26px;
            padding: 18px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .property-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 22px 55px rgba(15, 23, 42, 0.09);
        }

        .property-card-top {
            display: grid;
            grid-template-columns: 116px 1fr;
            gap: 16px;
            align-items: start;
        }

        .property-photo,
        .property-photo-placeholder {
            width: 116px;
            height: 100px;
            border-radius: 20px;
            border: 1px solid #e5e7eb;
            background: linear-gradient(135deg, #f8fafc, #eef2ff);
        }

        .property-photo {
            object-fit: cover;
        }

        .property-photo-placeholder {
            border-style: dashed;
            color: #94a3b8;
            font-size: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .property-card-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 10px;
        }

        .property-type {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            border-radius: 999px;
            padding: 6px 11px;
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
            font-size: 12px;
            font-weight: 950;
        }

        .property-menu-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            color: #0f172a;
            font-size: 22px;
            line-height: 1;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .property-menu-btn:hover {
            background: #f8fafc;
        }

        .property-price {
            color: #166534;
            font-size: 28px;
            line-height: 1.05;
            font-weight: 950;
            letter-spacing: -0.04em;
            margin-bottom: 8px;
        }

        .property-meta {
            color: #475569;
            font-size: 14px;
            line-height: 1.45;
        }

        .property-address {
            margin-top: 16px;
            color: #0f172a;
            font-size: 15px;
            line-height: 1.45;
        }

        .property-address strong {
            font-weight: 900;
        }

        .property-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 18px;
            padding-top: 16px;
            border-top: 1px solid #f1f5f9;
        }

        .property-checkbox-wrap {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
        }

        .property-checkbox {
            cursor: pointer;
            width: 18px;
            height: 18px;
        }

        .property-main-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .property-primary-btn,
        .property-secondary-btn {
            min-height: 40px;
            border-radius: 13px;
            padding: 0 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 900;
            text-decoration: none;
            border: none;
        }

        .property-primary-btn {
            background: #198754;
            color: #ffffff;
        }

        .property-primary-btn:hover {
            background: #157347;
            color: #ffffff;
        }

        .property-secondary-btn {
            background: #ffffff;
            border: 1px solid #dbe2ea;
            color: #0f172a;
        }

        .property-secondary-btn:hover {
            background: #f8fafc;
            color: #0f172a;
        }

        .property-muted-pill {
            min-height: 38px;
            border-radius: 999px;
            padding: 0 13px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            font-size: 13px;
            font-weight: 800;
        }

        .property-card-menu {
            border-radius: 16px;
            min-width: 240px;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.16);
            border: 1px solid #e5e7eb;
            padding: 8px;
        }

        .premium-locked-item {
            color: #94a3b8 !important;
            cursor: default;
        }

        .premium-locked-note {
            font-size: 11px;
            color: #64748b;
            padding: 8px 14px;
            line-height: 1.35;
        }

        .bulk-mobile-bar {
            display: none;
            position: fixed;
            left: 14px;
            right: 14px;
            bottom: 74px;
            z-index: 4000;
            min-height: 58px;
            background: #0f172a;
            color: #ffffff;
            border-radius: 18px;
            padding: 10px 12px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.28);
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .bulk-mobile-bar span {
            font-size: 14px;
            font-weight: 800;
        }

        .bulk-mobile-bar button {
            border-radius: 12px;
            font-weight: 900;
        }

        .ad-modal-content {
            white-space: pre-line;
            color: #334155;
            line-height: 1.65;
        }

        @media (max-width: 991px) {
            body {
                padding-bottom: 92px;
            }

            .property-grid {
                grid-template-columns: 1fr;
            }

            .property-list-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .property-list-toolbar .bulk-delete-btn {
                display: none !important;
            }

            .bulk-mobile-bar.is-visible {
                display: flex;
            }
        }

        @media (max-width: 576px) {
            .property-card {
                padding: 16px;
                border-radius: 22px;
            }

            .property-card-top {
                grid-template-columns: 86px 1fr;
                gap: 12px;
            }

            .property-photo,
            .property-photo-placeholder {
                width: 86px;
                height: 78px;
                border-radius: 16px;
            }

            .property-price {
                font-size: 23px;
            }

            .property-footer {
                align-items: stretch;
                flex-direction: column;
            }

            .property-main-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                width: 100%;
            }

            .property-primary-btn,
            .property-secondary-btn,
            .property-muted-pill {
                width: 100%;
            }
        }
    </style>

    <form method="post" action="{{ path('property_bulk_delete') }}" id="bulk-delete-form" onsubmit="return confirmBulkDelete();">
        <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_properties') }}">

        <div class="property-list-toolbar">
            <div class="property-count">
                {{ properties|length }} estimation(s)
            </div>

            <button type="submit" class="btn btn-outline-danger btn-sm bulk-delete-btn d-none" id="bulk-delete-btn">
                Supprimer la sélection
            </button>
        </div>

        <div class="property-grid">
            {% for p in properties %}
                {% set firstPhoto = p.photos|first %}

                <article class="property-card">
                    <div class="property-card-top">
                        {% if firstPhoto %}
                            <img src="{{ asset('uploads/properties/' ~ firstPhoto.filename) }}" alt="Photo du bien" class="property-photo" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="property-photo-placeholder" style="display: none;">⌂</div>
                        {% else %}
                            <div class="property-photo-placeholder">⌂</div>
                        {% endif %}

                        <div>
                            <div class="property-card-head">
                                <span class="property-type">{{ p.type }}</span>

                                <div class="dropup">
                                    <button class="property-menu-btn" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="Actions">
                                        ⋯
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end property-card-menu">
                                        <li>
                                            <button type="submit" form="generate-ad-form-{{ p.id }}" class="dropdown-item">
                                                Générer une annonce
                                            </button>
                                        </li>

                                        {% if p.adText %}
                                            <li>
                                                <button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="copyAd(this.dataset.ad)">
                                                    Copier l’annonce
                                                </button>
                                            </li>

                                            {% if isYearlyPremium %}
                                                <li>
                                                    <button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="copyLeboncoin(this.dataset.ad)">
                                                        Format Leboncoin
                                                    </button>
                                                </li>

                                                <li>
                                                    <button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="shareFacebook(this.dataset.ad)">
                                                        Publier sur Facebook
                                                    </button>
                                                </li>
                                            {% else %}
                                                <li>
                                                    <span class="dropdown-item premium-locked-item">
                                                        Leboncoin — Premium annuel
                                                    </span>
                                                </li>

                                                <li>
                                                    <span class="dropdown-item premium-locked-item">
                                                        Facebook — Premium annuel
                                                    </span>
                                                </li>

                                                <li>
                                                    <div class="premium-locked-note">
                                                        Passez à l’annuel pour débloquer les outils de diffusion.
                                                    </div>
                                                </li>
                                            {% endif %}
                                        {% endif %}

                                        <li>
                                            <a href="{{ path('property_pdf', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="dropdown-item">
                                                PDF classique
                                            </a>
                                        </li>

                                        <li>
                                            <a href="{{ path('property_edit', { id: p.id }) }}" class="dropdown-item">
                                                Modifier
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <button type="submit" form="delete-property-form-{{ p.id }}" class="dropdown-item text-danger" onclick="return confirm('Supprimer cette estimation ?');">
                                                Supprimer
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <div class="property-price">
                                {{ p.estimate|number_format(0, ',', ' ') }} €
                            </div>

                            <div class="property-meta">
                                {{ p.surface }} m²
                                {% if p.type|lower != 'parking' %}
                                    · {{ p.rooms }} pièces
                                {% endif %}
                                · Parking : {{ p.parking ? 'Oui' : 'Non' }}
                            </div>
                        </div>
                    </div>

                    <div class="property-address">
                        {% if p.address %}
                            <strong>{{ p.address }}</strong><br>
                        {% endif %}
                        {{ p.postalCode }} {{ p.city|upper }}

                        {% if p.photos|length > 0 %}
                            <br>
                            <span class="text-muted">{{ p.photos|length }} photo(s)</span>
                        {% endif %}
                    </div>

                    <div class="property-footer">
                        <label class="property-checkbox-wrap">
                            <input type="checkbox" name="property_ids[]" value="{{ p.id }}" class="property-checkbox" aria-label="Sélectionner cette estimation">
                            Sélectionner
                        </label>

                        <div class="property-main-actions">
                            {% if p.adText %}
                                <button type="button" class="property-secondary-btn" data-ad="{{ p.adText|e('html_attr') }}" onclick="openAdModal(this.dataset.ad)">
                                    Voir annonce
                                </button>

                                {% if isYearlyPremium %}
                                    <a href="{{ path('property_pdf_premium', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="property-primary-btn">
                                        PDF Premium
                                    </a>
                                {% else %}
                                    <a href="{{ path('property_pdf', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="property-primary-btn">
                                        PDF
                                    </a>
                                {% endif %}
                            {% else %}
                                <span class="property-muted-pill">
                                    Aucune annonce
                                </span>

                                <button type="submit" form="generate-ad-form-{{ p.id }}" class="property-primary-btn">
                                    Générer
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="bulk-mobile-bar" id="bulk-mobile-bar">
            <span id="bulk-mobile-count">0 sélection</span>

            <button type="submit" class="btn btn-danger btn-sm">
                Supprimer
            </button>
        </div>
    </form>

    {% for p in properties %}
        <form id="generate-ad-form-{{ p.id }}" method="post" action="{{ path('property_generate_ad', { id: p.id }) }}" class="d-none">
            <input type="hidden" name="_token" value="{{ csrf_token('generate_ad_' ~ p.id) }}">
        </form>

        <form id="delete-property-form-{{ p.id }}" method="post" action="{{ path('property_delete', { id: p.id }) }}" class="d-none">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_property_' ~ p.id) }}">
        </form>
    {% endfor %}

    <div class="modal fade" id="adModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Annonce générée</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>

                <div class="modal-body">
                    <div id="adContent" class="ad-modal-content"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="copyFromModal()">
                        Copier
                    </button>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Fermer
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentAd = '';

        function openAdModal(text) {
            currentAd = text || '';

            const adContent = document.getElementById('adContent');

            if (adContent) {
                adContent.innerText = currentAd;
            }

            const modalElement = document.getElementById('adModal');

            if (modalElement && window.bootstrap) {
                const modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        }

        function copyAd(text) {
            copyToClipboard(text || '', 'Annonce copiée');
        }

        function copyFromModal() {
            copyToClipboard(currentAd || '', 'Annonce copiée');
        }

        function copyLeboncoin(text) {
            const formatted = (text || '').replace(/\n/g, '\n\n').toUpperCase();

            copyToClipboard(formatted, 'Format Leboncoin copié');
        }

        function shareFacebook(text) {
            copyToClipboard(text || '', 'Annonce copiée pour Facebook');

            window.open('https://www.facebook.com/', '_blank', 'noopener,noreferrer');
        }

        function copyToClipboard(text, successMessage) {
            if (!navigator.clipboard) {
                showToast('Copie impossible sur ce navigateur', true);
                return;
            }

            navigator.clipboard.writeText(text)
                .then(() => showToast(successMessage))
                .catch(() => showToast('Erreur lors de la copie', true));
        }

        function showToast(message, isError = false) {
            const toast = document.createElement('div');

            toast.innerText = message;
            toast.style.position = 'fixed';
            toast.style.bottom = '20px';
            toast.style.right = '20px';
            toast.style.background = isError ? '#dc3545' : '#198754';
            toast.style.color = '#fff';
            toast.style.padding = '10px 15px';
            toast.style.borderRadius = '10px';
            toast.style.zIndex = '9999';
            toast.style.boxShadow = '0 10px 24px rgba(0,0,0,.18)';

            document.body.appendChild(toast);

            setTimeout(() => toast.remove(), 2000);
        }

        const checkboxes = document.querySelectorAll('.property-checkbox');
        const bulkDeleteBtn = document.getElementById('bulk-delete-btn');
        const bulkMobileBar = document.getElementById('bulk-mobile-bar');
        const bulkMobileCount = document.getElementById('bulk-mobile-count');

        function updateBulkDeleteState() {
            const checkedCount = document.querySelectorAll('.property-checkbox:checked').length;

            if (bulkDeleteBtn) {
                bulkDeleteBtn.classList.toggle('d-none', checkedCount === 0);
            }

            if (bulkMobileBar) {
                bulkMobileBar.classList.toggle('is-visible', checkedCount > 0);
            }

            if (bulkMobileCount) {
                bulkMobileCount.innerText = checkedCount + ' sélection' + (checkedCount > 1 ? 's' : '');
            }
        }

        checkboxes.forEach((checkbox) => {
            checkbox.addEventListener('change', updateBulkDeleteState);
        });

        function confirmBulkDelete() {
            const checkedCount = document.querySelectorAll('.property-checkbox:checked').length;

            if (checkedCount === 0) {
                return false;
            }

            return confirm('Supprimer ' + checkedCount + ' estimation(s) ?');
        }

        updateBulkDeleteState();
    </script>
{% endif %}