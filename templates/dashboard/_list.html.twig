{% set isYearlyPremium = app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'yearly' %}
{% set isMonthlyPremium = app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'monthly' %}

{% if properties is empty %}
	<div class="property-empty-state">
		<div class="property-empty-icon">🏠</div>

		<div class="property-empty-title">
			{{ 'properties.empty.title'|trans({}, 'dashboard') }}
		</div>

		<p class="property-empty-text">
			{{ 'properties.empty.text'|trans({}, 'dashboard') }}
		</p>
	</div>
{% else %}
	{% set properties = properties|sort((a, b) => b.estimate <=> a.estimate) %}

	<form method="post" action="{{ path('property_bulk_delete') }}" id="bulk-delete-form" onsubmit="return confirmBulkDelete();">
		<input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_properties') }}">

		<div class="property-list-toolbar">
			<div class="property-count">
				{{ properties|length }}
				{{ 'properties.count'|trans({}, 'dashboard') }}
			</div>

			<button type="submit" class="btn btn-outline-danger btn-sm bulk-delete-btn d-none" id="bulk-delete-btn">
				{{ 'properties.actions.delete_selection'|trans({}, 'dashboard') }}
			</button>
		</div>

		<div class="property-grid">
			{% for p in properties %}
				{% set firstPhoto = p.photos|first %}

				<article class="property-card">
					<div class="property-card-top">

						{% if firstPhoto %}
							<img src="{{ asset('uploads/properties/' ~ firstPhoto.filename) }}" alt="{{ 'properties.photo_alt'|trans({}, 'dashboard') }}" class="property-photo" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

							<div class="property-photo-placeholder" style="display:none;">⌂</div>
						{% else %}
							<div class="property-photo-placeholder">⌂</div>
						{% endif %}

						<div>
							<div class="property-card-head">

								<span class="property-type">
									{{ p.type }}
								</span>

								<div class="dropup">

									<button class="property-menu-btn" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="{{ 'properties.actions.label'|trans({}, 'dashboard') }}">
										⋯
									</button>

									<ul class="dropdown-menu dropdown-menu-end property-card-menu">

										<li>
											<button type="submit" form="generate-ad-form-{{ p.id }}" class="dropdown-item">
												{{ 'properties.actions.generate_ad'|trans({}, 'dashboard') }}
											</button>
										</li>

										{% if p.adText %}

											<li>
												<button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="copyAd(this.dataset.ad)">
													{{ 'properties.actions.copy_ad'|trans({}, 'dashboard') }}
												</button>
											</li>

											{% if isYearlyPremium %}

												<li>
													<button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="copyLeboncoin(this.dataset.ad)">
														{{ 'properties.actions.leboncoin_format'|trans({}, 'dashboard') }}
													</button>
												</li>

												<li>
													<button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="shareFacebook(this.dataset.ad)">
														{{ 'properties.actions.facebook_publish'|trans({}, 'dashboard') }}
													</button>
												</li>

											{% else %}

												<li>
													<span class="dropdown-item premium-locked-item">
														{{ 'properties.premium.leboncoin_locked'|trans({}, 'dashboard') }}
													</span>
												</li>

												<li>
													<span class="dropdown-item premium-locked-item">
														{{ 'properties.premium.facebook_locked'|trans({}, 'dashboard') }}
													</span>
												</li>

												<li>
													<div class="premium-locked-note">
														{{ 'properties.premium.note'|trans({}, 'dashboard') }}
													</div>
												</li>

											{% endif %}

										{% endif %}

										<li>
											<a href="{{ path('property_pdf', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="dropdown-item">
												{{ 'properties.actions.pdf_classic'|trans({}, 'dashboard') }}
											</a>
										</li>

										<li>
											<a href="{{ path('property_edit', { id: p.id }) }}" class="dropdown-item">
												{{ 'properties.actions.edit'|trans({}, 'dashboard') }}
											</a>
										</li>

										<li><hr class="dropdown-divider"></li>

										<li>
											<button type="submit" form="delete-property-form-{{ p.id }}" class="dropdown-item text-danger" onclick="return confirm('{{ 'properties.confirm.delete_one'|trans({}, 'dashboard')|e('js') }}');">
												{{ 'properties.actions.delete'|trans({}, 'dashboard') }}
											</button>
										</li>

									</ul>
								</div>
							</div>

							<div class="property-price">
								{{ p.estimate|number_format(0, ',', ' ') }}
								€
							</div>

							<div class="property-meta">

								{{ p.surface }}
								m²

								{% if p.type|lower != 'parking' %}
									·
									{{ p.rooms }}
									{{ 'properties.meta.rooms'|trans({}, 'dashboard') }}
								{% endif %}

								·
								{{ 'properties.meta.parking'|trans({}, 'dashboard') }}
								:
								{{ p.parking
									? 'properties.meta.yes'|trans({}, 'dashboard')
									: 'properties.meta.no'|trans({}, 'dashboard')
								}}

							</div>
						</div>
					</div>

					<div class="property-address">

						{% if p.address %}
							<strong>{{ p.address }}</strong><br>
						{% endif %}

						{{ p.postalCode }}
						{{ p.city|upper }}

						{% if p.photos|length > 0 %}
							<br>

							<span class="text-muted">
								{{ p.photos|length }}
								{{ 'properties.meta.photos'|trans({}, 'dashboard') }}
							</span>
						{% endif %}

					</div>

					<div class="property-footer">

						<label class="property-checkbox-wrap">

							<input type="checkbox" name="property_ids[]" value="{{ p.id }}" class="property-checkbox" aria-label="{{ 'properties.actions.select_aria'|trans({}, 'dashboard') }}">

							{{ 'properties.actions.select'|trans({}, 'dashboard') }}

						</label>

						<div class="property-main-actions">

							{% if p.adText %}

								<button type="button" class="property-secondary-btn" data-ad="{{ p.adText|e('html_attr') }}" onclick="openAdModal(this.dataset.ad)">
									{{ 'properties.actions.view_ad'|trans({}, 'dashboard') }}
								</button>

								{% if isYearlyPremium %}

									<a href="{{ path('property_pdf_premium', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="property-primary-btn">
										{{ 'properties.actions.pdf_premium'|trans({}, 'dashboard') }}
									</a>

								{% else %}

									<a href="{{ path('property_pdf', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="property-primary-btn">
										{{ 'properties.actions.pdf'|trans({}, 'dashboard') }}
									</a>

								{% endif %}

							{% else %}

								<span class="property-muted-pill">
									{{ 'properties.ad.none'|trans({}, 'dashboard') }}
								</span>

								<button type="submit" form="generate-ad-form-{{ p.id }}" class="property-primary-btn">
									{{ 'properties.actions.generate'|trans({}, 'dashboard') }}
								</button>

							{% endif %}

						</div>
					</div>
				</article>

			{% endfor %}
		</div>

		<div class="bulk-mobile-bar" id="bulk-mobile-bar">

			<span id="bulk-mobile-count">
				0
				{{ 'properties.actions.selection'|trans({}, 'dashboard') }}
			</span>

			<button type="submit" class="btn btn-danger btn-sm">
				{{ 'properties.actions.delete'|trans({}, 'dashboard') }}
			</button>

		</div>
	</form>

	{% for p in properties %}

		<form id="generate-ad-form-{{ p.id }}" method="post" action="{{ path('property_generate_ad', { id: p.id }) }}" class="d-none">
			<input type="hidden" name="_token" value="{{ csrf_token('generate_ad_' ~ p.id) }}">
		</form>

		<form id="delete-property-form-{{ p.id }}" method="post" action="{{ path('property_delete', { id: p.id }) }}" class="d-none">
			<input type="hidden" name="_token" value="{{ csrf_token('delete_property_' ~ p.id) }}">
		</form>

	{% endfor %}

	<div class="modal fade" id="adModal" tabindex="-1" aria-hidden="true">

		<div class="modal-dialog modal-lg modal-dialog-centered">

			<div class="modal-content shadow">

				<div class="modal-header">

					<h5 class="modal-title">
						{{ 'properties.modal.title'|trans({}, 'dashboard') }}
					</h5>

					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'properties.modal.close'|trans({}, 'dashboard') }}"></button>

				</div>

				<div class="modal-body">
					<div id="adContent" class="ad-modal-content"></div>
				</div>

				<div class="modal-footer">

					<button type="button" class="btn btn-success" onclick="copyFromModal()">
						{{ 'properties.actions.copy'|trans({}, 'dashboard') }}
					</button>

					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						{{ 'properties.modal.close'|trans({}, 'dashboard') }}
					</button>

				</div>

			</div>
		</div>
	</div>

{% endif %}
