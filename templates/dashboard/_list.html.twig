{% set isYearlyPremium = app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'yearly' %}
{% set isMonthlyPremium = app.user and app.user.subscriptionStatus == 'active' and app.user.currentPlan == 'monthly' %}

{% if properties is empty %}
	<div class="property-empty-state">
		<div class="property-empty-icon">🏠</div>
		<div class="property-empty-title">Aucune estimation pour le moment</div>
		<p class="property-empty-text">Ajoutez votre premier bien pour générer une estimation.</p>
	</div>
{% else %}
	{% set properties = properties|sort((a, b) => b.estimate <=> a.estimate) %}

	<form method="post" action="{{ path('property_bulk_delete') }}" id="bulk-delete-form" onsubmit="return confirmBulkDelete();">
		<input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_properties') }}">

		<div class="property-list-toolbar">
			<div class="property-count">
				{{ properties|length }}
				estimation(s)
			</div>

			<button type="submit" class="btn btn-outline-danger btn-sm bulk-delete-btn d-none" id="bulk-delete-btn">
				Supprimer la sélection
			</button>
		</div>

		<div class="property-grid">
			{% for p in properties %}
				{% set firstPhoto = p.photos|first %}

				<article class="property-card">
					<div class="property-card-top">
						{% if firstPhoto %}
							<img src="{{ firstPhoto.displayUrl }}" alt="Photo du bien" class="property-photo" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
							<div class="property-photo-placeholder" style="display: none;">⌂</div>
						{% else %}
							<div class="property-photo-placeholder">⌂</div>
						{% endif %}

						<div>
							<div class="property-card-head">
								<span class="property-type">{{ p.type }}</span>

								<div class="dropup">
									<button class="property-menu-btn" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="Actions">
										⋯
									</button>

									<ul class="dropdown-menu dropdown-menu-end property-card-menu">
										<li>
											<button type="submit" form="generate-ad-form-{{ p.id }}" class="dropdown-item">
												Générer une annonce
											</button>
										</li>

										{% if p.adText %}
											<li>
												<button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" onclick="copyAd(this.dataset.ad)">
													Copier l’annonce
												</button>
											</li>

											{% if isYearlyPremium %}
												<li>
													<button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" data-type="{{ p.type|e('html_attr') }}" data-price="{{ p.estimate }}" data-surface="{{ p.surface }}" data-rooms="{{ p.rooms }}" data-parking="{{ p.parking ? 'Oui' : 'Non' }}" data-address="{{ p.address|default('')|e('html_attr') }}" data-postal-code="{{ p.postalCode|e('html_attr') }}" data-city="{{ p.city|e('html_attr') }}" onclick="copyLeboncoin(this.dataset)">
														Format Leboncoin
													</button>
												</li>

												<li>
													<button type="button" class="dropdown-item" data-ad="{{ p.adText|e('html_attr') }}" data-type="{{ p.type|e('html_attr') }}" data-price="{{ p.estimate }}" data-surface="{{ p.surface }}" data-rooms="{{ p.rooms }}" data-parking="{{ p.parking ? 'Oui' : 'Non' }}" data-address="{{ p.address|default('')|e('html_attr') }}" data-postal-code="{{ p.postalCode|e('html_attr') }}" data-city="{{ p.city|e('html_attr') }}" onclick="shareFacebook(this.dataset)">
														Publier sur Facebook
													</button>
												</li>
											{% else %}
												<li>
													<span class="dropdown-item premium-locked-item">Leboncoin — Premium annuel</span>
												</li>

												<li>
													<span class="dropdown-item premium-locked-item">Facebook — Premium annuel</span>
												</li>

												<li>
													<div class="premium-locked-note">
														Passez à l’annuel pour débloquer les outils de diffusion.
													</div>
												</li>
											{% endif %}
										{% endif %}

										<li>
											<a href="{{ path('property_pdf', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="dropdown-item">
												PDF classique
											</a>
										</li>

										<li>
											<a href="{{ path('property_edit', { id: p.id }) }}" class="dropdown-item">
												Modifier
											</a>
										</li>

										<li>
											<button type="submit" form="recalculate-property-form-{{ p.id }}" class="dropdown-item" onclick="return confirm('Recalculer cette estimation ?');">
												Recalculer l’estimation
											</button>
										</li>

										<li><hr class="dropdown-divider"></li>

										<li>
											<button type="submit" form="delete-property-form-{{ p.id }}" class="dropdown-item text-danger" onclick="return confirm('Supprimer cette estimation ?');">
												Supprimer
											</button>
										</li>
									</ul>
								</div>
							</div>

							<div class="property-price">
								{{ p.estimate|number_format(0, ',', ' ') }}
								€
							</div>

							<div class="property-meta">
								{{ p.surface }}
								m²
								{% if p.type|lower != 'parking' %}
									·
									{{ p.rooms }}
									pièces
								{% endif %}
								· Parking :
								{{ p.parking ? 'Oui' : 'Non' }}
							</div>
						</div>
					</div>

					<div class="property-address">
						{% if p.address %}
							<strong>{{ p.address }}</strong><br>
						{% endif %}

						{{ p.postalCode }}
						{{ p.city|upper }}

						{% if p.photos|length > 0 %}
							<br>
							<span class="text-muted">{{ p.photos|length }}
								photo(s)</span>
						{% endif %}
					</div>

					<div class="property-footer">
						<label class="property-checkbox-wrap">
							<input type="checkbox" name="property_ids[]" value="{{ p.id }}" class="property-checkbox" aria-label="Sélectionner cette estimation">
							Sélectionner
						</label>

						<div class="property-main-actions">
							{% if p.adText %}
								<button type="button" class="property-secondary-btn" data-ad="{{ p.adText|e('html_attr') }}" onclick="openAdModal(this.dataset.ad)">
									Voir annonce
								</button>

								{% if isYearlyPremium %}
									<a href="{{ path('property_pdf_premium', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="property-primary-btn">
										PDF Premium
									</a>
								{% else %}
									<a href="{{ path('property_pdf', { id: p.id }) }}" target="_blank" rel="noopener noreferrer" class="property-primary-btn">
										PDF
									</a>
								{% endif %}
							{% else %}
								<span class="property-muted-pill">Aucune annonce</span>

								<button type="submit" form="generate-ad-form-{{ p.id }}" class="property-primary-btn">
									Générer
								</button>
							{% endif %}
						</div>
					</div>
				</article>
			{% endfor %}
		</div>

		<div class="bulk-mobile-bar" id="bulk-mobile-bar">
			<span id="bulk-mobile-count">0 sélection</span>

			<button type="submit" class="btn btn-danger btn-sm">
				Supprimer
			</button>
		</div>
	</form>

	{% for p in properties %}
		<form id="generate-ad-form-{{ p.id }}" method="post" action="{{ path('property_generate_ad', { id: p.id }) }}" class="d-none">
			<input type="hidden" name="_token" value="{{ csrf_token('generate_ad_' ~ p.id) }}">
		</form>

		<form id="recalculate-property-form-{{ p.id }}" method="post" action="{{ path('property_recalculate', { id: p.id }) }}" class="d-none">
			<input type="hidden" name="_token" value="{{ csrf_token('recalculate_property_' ~ p.id) }}">
		</form>

		<form id="delete-property-form-{{ p.id }}" method="post" action="{{ path('property_delete', { id: p.id }) }}" class="d-none">
			<input type="hidden" name="_token" value="{{ csrf_token('delete_property_' ~ p.id) }}">
		</form>
	{% endfor %}

	<div class="modal fade" id="adModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-centered">
			<div class="modal-content shadow">
				<div class="modal-header">
					<h5 class="modal-title">Annonce générée</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>

				<div class="modal-body">
					<div id="adContent" class="ad-modal-content"></div>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-success" onclick="copyFromModal()">
						Copier
					</button>

					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						Fermer
					</button>
				</div>
			</div>
		</div>
	</div>

{% endif %}
