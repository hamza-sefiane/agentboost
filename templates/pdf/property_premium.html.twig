<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Dossier d’estimation immobilière premium</title>

    <style>
        {{ source('pdf/property_premium.css') }}
    </style>
</head>

<body>

{% set agencyName = app.user.companyName ?: 'AgentBoost Immobilier' %}
{% set agencyPhone = app.user.companyPhone %}
{% set agencyEmail = app.user.agencyEmail %}
{% set agencyWebsite = app.user.agencyWebsite %}
{% set agencyStreet = app.user.agencyStreet %}
{% set agencyAddressComplement = app.user.agencyAddressComplement %}
{% set agencyPostalCode = app.user.agencyPostalCode %}
{% set agencyCity = app.user.agencyCity %}

<div class="premium-cover">
    {% if photoDataUris is defined and photoDataUris|length > 0 %}
        <img src="{{ photoDataUris[0] }}" class="premium-cover-image" alt="Bien immobilier">
    {% endif %}

    <div class="premium-cover-overlay"></div>

    <div class="premium-cover-content">
        <div class="premium-cover-top">
            {% if logoDataUri %}
                <img src="{{ logoDataUri }}" class="premium-cover-logo" alt="Logo agence">
            {% endif %}
        </div>

        <div class="premium-cover-center">
            <div class="premium-cover-badge">ESTIMATION PREMIUM</div>

            <h1 class="premium-cover-title">
                DOSSIER D’ESTIMATION<br>
                IMMOBILIÈRE
            </h1>

            <div class="premium-cover-location">
                {% if property.address %}
                    {{ property.address }}<br>
                {% endif %}
                {{ property.postalCode }} {{ property.city|upper }}
            </div>

            <div class="premium-cover-price-card">
                <div class="premium-cover-price-label">Valeur estimée</div>

                <div class="premium-cover-price">
                    {{ property.estimate|number_format(0, ',', ' ') }} €
                </div>

                {% if property.lowEstimate and property.highEstimate %}
                    <div class="premium-cover-range">
                        {{ property.lowEstimate|number_format(0, ',', ' ') }} €
                        —
                        {{ property.highEstimate|number_format(0, ',', ' ') }} €
                    </div>
                {% endif %}

                <div class="premium-cover-score">
                    Score IA : {{ confidenceScore|default(92) }}%
                </div>
            </div>
        </div>

        <div class="premium-cover-footer">
            <div>{{ agencyName }}</div>
            <div>Généré le {{ "now"|date('d/m/Y') }}</div>
        </div>
    </div>
</div>

<div class="page">
    <div class="header">
        <div class="company-label">Agence immobilière</div>

        <div class="company-name">
            {{ agencyName }}
        </div>

        <div class="company-info">
            {% if agencyStreet %}
                {{ agencyStreet }}{% if agencyAddressComplement %} — {{ agencyAddressComplement }}{% endif %}<br>
            {% elseif agencyAddressComplement %}
                {{ agencyAddressComplement }}<br>
            {% endif %}

            {% if agencyPostalCode or agencyCity %}
                {{ agencyPostalCode }} {{ agencyCity }}<br>
            {% elseif app.user.companyAddress %}
                {{ app.user.companyAddress|nl2br }}<br>
            {% else %}
                Adresse non renseignée<br>
            {% endif %}

            {% if agencyPhone %}
                Tél : {{ agencyPhone }}<br>
            {% endif %}

            {% if agencyEmail %}
                {{ agencyEmail }}<br>
            {% endif %}

            {% if agencyWebsite %}
                {{ agencyWebsite }}
            {% endif %}
        </div>
    </div>

    {% if photoDataUris is defined and photoDataUris|length > 0 %}
        <div class="section">
            <div class="section-title">Galerie du bien</div>

            <div class="photo-hero-wrapper">
                <img src="{{ photoDataUris[0] }}" class="photo-hero" alt="Photo principale du bien">
            </div>

            {% if photoDataUris|length > 1 %}
                <table class="photo-table">
                    <tr>
                        {% for photoDataUri in photoDataUris|slice(1, 4) %}
                            <td class="photo-thumb-cell">
                                <img src="{{ photoDataUri }}" class="photo-thumb" alt="Photo du bien">
                            </td>
                        {% endfor %}
                    </tr>
                </table>
            {% endif %}

            <div class="gallery-count">
                {{ photoDataUris|length }} photo(s) jointe(s)
            </div>
        </div>
    {% endif %}

    <div class="estimate-summary">
        <table class="estimate-summary-table">
            <tr>
                <td>
                    <div class="estimate-main-label">Estimation cible</div>
                    <div class="estimate-main-value">
                        {{ property.estimate|number_format(0, ',', ' ') }} €
                    </div>
                </td>

                <td class="estimate-range-box">
                    {% if property.lowEstimate and property.highEstimate %}
                        Fourchette basse / haute<br>
                        <strong>
                            {{ property.lowEstimate|number_format(0, ',', ' ') }} €
                            —
                            {{ property.highEstimate|number_format(0, ',', ' ') }} €
                        </strong>
                    {% else %}
                        Fourchette non disponible
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>

    <div class="section">
        <div class="section-title">Bien estimé</div>

        <table class="property-grid-table">
            <tr>
                <td class="property-card">
                    <div class="property-card-label">Type</div>
                    <div class="property-card-value">{{ property.type }}</div>
                </td>

                <td class="property-card">
                    <div class="property-card-label">Surface</div>
                    <div class="property-card-value">{{ property.surface }} m²</div>
                </td>
            </tr>

            <tr>
                <td class="property-card">
                    <div class="property-card-label">Pièces</div>
                    <div class="property-card-value">{{ property.rooms }}</div>
                </td>

                <td class="property-card">
                    <div class="property-card-label">Parking</div>
                    <div class="property-card-value">{{ property.parking ? 'Oui' : 'Non' }}</div>
                </td>
            </tr>

            <tr>
                <td colspan="2" class="property-card property-card-full">
                    <div class="property-card-label">Localisation</div>
                    <div class="property-card-value">
                        {% if property.address %}
                            {{ property.address }}<br>
                        {% endif %}
                        {{ property.postalCode }} {{ property.city|upper }}
                    </div>
                </td>
            </tr>
        </table>
    </div>

    <div class="section no-break">
        <div class="section-title">Synthèse de l’estimation</div>

        <table class="market-table">
            <tr>
                <td class="market-card">
                    <div class="market-title">Prix estimé au m²</div>
                    <div class="market-value">
                        {{ (property.estimate / property.surface)|round(0, 'floor')|number_format(0, ',', ' ') }} €/m²
                    </div>
                    <div class="market-sub">Calculé à partir de l’estimation cible</div>
                </td>

                <td class="market-card">
                    <div class="market-title">Fiabilité</div>
                    <div class="market-value">
                        {{ confidenceScore|default(80) }} %
                    </div>
                    <div class="market-sub">Indice basé sur les informations renseignées</div>
                </td>

                <td class="market-card">
                    <div class="market-title">Délai estimé</div>
                    <div class="market-value">
                        {{ estimatedSaleDelay|default('45 à 60 jours') }}
                    </div>
                    <div class="market-sub">Projection indicative de mise en vente</div>
                </td>
            </tr>
        </table>
    </div>

    {% if comparables is defined and comparables is not empty %}
        <div class="section no-break comparable-section comparable-page-start">
            <div class="section-title">Analyse comparative du marché</div>

            <table class="comparable-table">
                <tr>
                    {% for comparable in comparables %}
                        <td class="comparable-card">
                            <div class="comparable-label">Comparable {{ loop.index }}</div>

                            <div class="comparable-type">
                                {{ comparable.type }}
                            </div>

                            <div class="comparable-location">
                                {{ comparable.city|upper }}
                            </div>

                            <div class="comparable-surface">
                                {{ comparable.surface }} m²
                            </div>

                            <div class="comparable-price">
                                {{ comparable.lowPrice|number_format(0, ',', ' ') }} €
                                —
                                {{ comparable.highPrice|number_format(0, ',', ' ') }} €
                            </div>
                        </td>
                    {% endfor %}
                </tr>
            </table>

            {% if marketPosition is defined and marketPosition %}
                <div class="market-position-box">
                    {{ marketPosition }}
                </div>
            {% endif %}

            <div class="comparable-note">
                Données comparatives générées à titre indicatif à partir des caractéristiques du bien estimé.
            </div>
        </div>
    {% endif %}

    <div class="section no-break">
        <div class="strategy-card">
            <div class="strategy-title">Stratégie de mise en vente recommandée</div>

            <table class="strategy-metrics">
                <tr>
                    <td class="strategy-metric">
                        <div class="strategy-metric-label">Prix d’affichage conseillé</div>
                        <div class="strategy-metric-value">
                            {{ property.highEstimate ? property.highEstimate|number_format(0, ',', ' ') ~ ' €' : property.estimate|number_format(0, ',', ' ') ~ ' €' }}
                        </div>
                    </td>

                    <td class="strategy-metric">
                        <div class="strategy-metric-label">Seuil de négociation</div>
                        <div class="strategy-metric-value">
                            {{ property.lowEstimate ? property.lowEstimate|number_format(0, ',', ' ') ~ ' €' : property.estimate|number_format(0, ',', ' ') ~ ' €' }}
                        </div>
                    </td>
                </tr>
            </table>

            {% if sellingStrategy is defined and sellingStrategy is not empty %}
                <ul class="strategy-list">
                    {% for item in sellingStrategy %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>

    <table class="two-column-table no-break">
        <tr>
            {% if sellingAdvices is defined and sellingAdvices is not empty %}
                <td class="two-column-cell">
                    <div class="section">
                        <div class="section-title">Conseils avant mise en vente</div>

                        <div class="advice-box">
                            <ul class="advice-list">
                                {% for advice in sellingAdvices %}
                                    <li>{{ advice }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </td>
            {% endif %}

            {% if property.adText %}
                <td class="two-column-cell">
                    <div class="section">
                        <div class="section-title">Annonce IA</div>

                        <div class="ad-box">
                            {{ property.adText }}
                        </div>
                    </div>
                </td>
            {% endif %}
        </tr>
    </table>
    <div class="signature-spacer"></div>

    <table class="signature-table">
        <tr>
            <td class="signature-card">
                <div class="signature-label">Document présenté par</div>

                <div class="signature-name">
                    {{ agencyName }}
                </div>

                <div class="company-info">
                    {% if agencyStreet %}
                        {{ agencyStreet }}{% if agencyAddressComplement %} — {{ agencyAddressComplement }}{% endif %}<br>
                    {% elseif agencyAddressComplement %}
                        {{ agencyAddressComplement }}<br>
                    {% endif %}

                    {% if agencyPostalCode or agencyCity %}
                        {{ agencyPostalCode }} {{ agencyCity }}<br>
                    {% elseif app.user.companyAddress %}
                        {{ app.user.companyAddress|nl2br }}<br>
                    {% endif %}

                    {% if agencyPhone %}
                        Tél : {{ agencyPhone }}<br>
                    {% endif %}

                    {% if agencyEmail %}
                        {{ agencyEmail }}<br>
                    {% endif %}

                    {% if agencyWebsite %}
                        {{ agencyWebsite }}
                    {% endif %}
                </div>

                <div class="signature-line"></div>
            </td>

            <td class="qr-card">
                {% set qrUrl = absolute_url(path('property_pdf_premium', { id: property.id })) %}

                <div class="qr-box">
                    <img src="{{ qr_code_data_uri(qrUrl) }}" alt="QR code estimation premium">
                </div>

                <div class="qr-text">
                    Scanner pour ouvrir<br>
                    cette estimation
                </div>
            </td>
        </tr>
    </table>

    <div class="footer">
        Estimation immobilière confidentielle — Générée via AgentBoost.<br>
        Document non contractuel — Référence : AB-{{ property.id }}-{{ "now"|date('Ymd') }}
    </div>
</div>

</body>
</html>