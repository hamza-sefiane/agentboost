<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
	<head>
		<meta charset="UTF-8">
		<title>{{ 'premium.meta.title'|trans({}, 'pdf') }}</title>

		<style>
			{{source('pdf/property_premium.css')}}</style>
	</head>

	<body>
		{% set currentUser = app.user %}
		{% set agencyName = currentUser.companyName|default('') ?: 'AgentBoost Immobilier' %}
		{% set agencyPhone = currentUser.companyPhone|default(null) %}
		{% set agencyEmail = currentUser.agencyEmail|default(null) %}
		{% set agencyWebsite = currentUser.agencyWebsite|default(null) %}
		{% set agencyStreet = currentUser.agencyStreet|default(null) %}
		{% set agencyAddressComplement = currentUser.agencyAddressComplement|default(null) %}
		{% set agencyPostalCode = currentUser.agencyPostalCode|default(null) %}
		{% set agencyCity = currentUser.agencyCity|default(null) %}
		{% set agencyLegacyAddress = currentUser.companyAddress|default(null) %}
		{% set photos = photoDataUris is defined and photoDataUris is iterable ? photoDataUris : [] %}
		{% set hasSurface = property.surface is defined and property.surface > 0 %}
		{% set isSpecialAsset = property.type is defined and property.type|lower in ['parking', 'terrain'] %}

		<div class="premium-cover">
			{% if photos|length > 0 %}
				<img src="{{ photos[0] }}" class="premium-cover-image" alt="{{ 'property.title'|trans({}, 'pdf') }}">
			{% endif %}

			<div class="premium-cover-overlay"></div>

			<div class="premium-cover-content premium-cover-content-clean">
				<div class="premium-cover-top">
					{% if logoDataUri is defined and logoDataUri %}
						<img src="{{ logoDataUri }}" class="premium-cover-logo" alt="{{ 'company.label'|trans({}, 'pdf') }}">
					{% endif %}
				</div>

				<div class="premium-cover-card">
					<div class="premium-cover-badge">
						{{ 'cover.badge'|trans({}, 'pdf') }}
					</div>

					<div class="premium-cover-document-type">
						{{ 'premium.meta.title'|trans({}, 'pdf') }}
					</div>

					<h1 class="premium-cover-title">
						{{ 'cover.title_line_1'|trans({}, 'pdf') }}<br>
						{{ 'cover.title_line_2'|trans({}, 'pdf') }}
					</h1>

					<div class="premium-cover-location">
						{% if property.address %}
							{{ property.address }}<br>
						{% endif %}
						{{ property.postalCode }}
						{{ property.city|upper }}
					</div>

					<div class="premium-cover-price-label">
						{{ 'cover.estimated_value'|trans({}, 'pdf') }}
					</div>

					<div class="premium-cover-price">
						{{ property.estimate|number_format(0, ',', ' ') }}
						€
					</div>

					{% if property.lowEstimate and property.highEstimate %}
						<div class="premium-cover-range">
							{{ property.lowEstimate|number_format(0, ',', ' ') }}
							€
																																																																																																																																					—
							{{ property.highEstimate|number_format(0, ',', ' ') }}
							€
						</div>
					{% endif %}

					<div class="premium-cover-score">
						{{ 'cover.ai_score'|trans({}, 'pdf') }}
						:
						{{ confidenceScore|default(92) }}%
					</div>
				</div>

				<div class="premium-cover-footer">
					<div>{{ agencyName }}</div>
					<div>
						{{ 'cover.generated_on'|trans({}, 'pdf') }}
						{{ "now"|date('d/m/Y') }}
					</div>
				</div>
			</div>
		</div>

		<div class="page">
			<div class="header">
				<div class="company-label">{{ 'company.label'|trans({}, 'pdf') }}</div>
				<div class="company-name">{{ agencyName }}</div>

				<div class="company-info">
					{% if agencyStreet %}
						{{ agencyStreet }}
						{% if agencyAddressComplement %}
							—
							{{ agencyAddressComplement }}
						{% endif %}<br>
					{% elseif agencyAddressComplement %}
						{{ agencyAddressComplement }}<br>
					{% endif %}

					{% if agencyPostalCode or agencyCity %}
						{{ agencyPostalCode }}
						{{ agencyCity }}<br>
					{% elseif agencyLegacyAddress %}
						{{ agencyLegacyAddress|nl2br }}<br>
					{% else %}
						Adresse non renseignée<br>
					{% endif %}

					{% if agencyPhone %}
						Tél :
						{{ agencyPhone }}<br>
					{% endif %}

					{% if agencyEmail %}
						{{ agencyEmail }}<br>
					{% endif %}

					{% if agencyWebsite %}
						{{ agencyWebsite }}
					{% endif %}
				</div>
			</div>

			{% if photos|length > 0 %}
				<div class="section">
					<div class="section-title">{{ 'gallery.title'|trans({}, 'pdf') }}</div>

					<div class="photo-hero-wrapper">
						<img src="{{ photos[0] }}" class="photo-hero" alt="{{ 'gallery.title'|trans({}, 'pdf') }}">
					</div>

					{% if photos|length > 1 %}
						<table class="photo-table">
							<tr>
								{% for photoDataUri in photos|slice(1, 4) %}
									<td class="photo-thumb-cell">
										<img src="{{ photoDataUri }}" class="photo-thumb" alt="{{ 'gallery.title'|trans({}, 'pdf') }}">
									</td>
								{% endfor %}
							</tr>
						</table>
					{% endif %}

					<div class="gallery-count">
						{{ photos|length }}
						{{ 'gallery.attached_photos'|trans({}, 'pdf') }}
					</div>
				</div>
			{% endif %}

			<div class="estimate-summary">
				<table class="estimate-summary-table">
					<tr>
						<td>
							<div class="estimate-main-label">{{ 'estimate.target'|trans({}, 'pdf') }}</div>
							<div class="estimate-main-value">
								{{ property.estimate|number_format(0, ',', ' ') }}
								€
							</div>
						</td>

						<td class="estimate-range-box">
							{% if property.lowEstimate and property.highEstimate %}
								{{ 'estimate.range.available'|trans({}, 'pdf') }}<br>
								<strong>
									{{ property.lowEstimate|number_format(0, ',', ' ') }}
									€
																																																																																																																																																																											—
									{{ property.highEstimate|number_format(0, ',', ' ') }}
									€
								</strong>
							{% else %}
								{{ 'estimate.range.unavailable'|trans({}, 'pdf') }}
							{% endif %}
						</td>
					</tr>
				</table>
			</div>

			<div class="section">
				<div class="section-title">{{ 'property.title'|trans({}, 'pdf') }}</div>

				<table class="property-grid-table">
					<tr>
						<td class="property-card">
							<div class="property-card-label">{{ 'property.type'|trans({}, 'pdf') }}</div>
							<div class="property-card-value">{{ property.type }}</div>
						</td>

						<td class="property-card">
							<div class="property-card-label">{{ 'property.surface'|trans({}, 'pdf') }}</div>
							<div class="property-card-value">
								{% if hasSurface %}
									{{ property.surface }}
									m²{% else %}—
								{% endif %}
							</div>
						</td>
					</tr>

					<tr>
						<td class="property-card">
							<div class="property-card-label">{{ 'property.rooms'|trans({}, 'pdf') }}</div>
							<div class="property-card-value">
								{{ isSpecialAsset ? '—' : property.rooms|default('—') }}
							</div>
						</td>

						<td class="property-card">
							<div class="property-card-label">{{ 'property.parking'|trans({}, 'pdf') }}</div>
							<div class="property-card-value">
								{{ property.parking ? 'property.yes'|trans({}, 'pdf') : 'property.no'|trans({}, 'pdf') }}
							</div>
						</td>
					</tr>

					<tr>
						<td colspan="2" class="property-card property-card-full">
							<div class="property-card-label">{{ 'property.location'|trans({}, 'pdf') }}</div>
							<div class="property-card-value">
								{% if property.address %}
									{{ property.address }}<br>
								{% endif %}
								{{ property.postalCode }}
								{{ property.city|upper }}
							</div>
						</td>
					</tr>
				</table>
			</div>

			<div class="section no-break">
				<div class="section-title">{{ 'summary.title'|trans({}, 'pdf') }}</div>

				<table class="market-table">
					<tr>
						<td class="market-card">
							<div class="market-title">{{ 'summary.estimated_price_m2'|trans({}, 'pdf') }}</div>
							<div class="market-value">
								{% if hasSurface %}
									{{ (property.estimate / property.surface)|round(0, 'floor')|number_format(0, ',', ' ') }}
									€/m²
								{% else %}
									—
								{% endif %}
							</div>
							<div class="market-sub">{{ 'summary.based_on_target'|trans({}, 'pdf') }}</div>
						</td>

						<td class="market-card">
							<div class="market-title">{{ 'summary.reliability'|trans({}, 'pdf') }}</div>
							<div class="market-value">{{ confidenceScore|default(80) }}
								%</div>
							<div class="market-sub">{{ 'summary.reliability_index'|trans({}, 'pdf') }}</div>
						</td>

						<td class="market-card">
							<div class="market-title">{{ 'summary.estimated_delay'|trans({}, 'pdf') }}</div>
							<div class="market-value">{{ estimatedSaleDelay|default('45 à 60 jours') }}</div>
							<div class="market-sub">{{ 'summary.indicative_projection'|trans({}, 'pdf') }}</div>
						</td>
					</tr>
				</table>
			</div>

			{% if comparables is defined and comparables is iterable and comparables is not empty %}
				{% set displayedComparables = comparables|slice(0, 10) %}
				<div class="section no-break comparable-section comparable-page-start">
					<div class="section-title">{{ 'comparables.title'|trans({}, 'pdf') }}</div>

					<div class="comparable-note">
						{{ 'comparables.intro'|trans({
							'%count%': comparableStats.count|default(displayedComparables|length)
						}, 'pdf') }}

						{{ 'comparables.intro_details'|trans({}, 'pdf') }}
					</div>

					{% if comparableStats is defined and comparableStats %}
						<table class="comparable-stats-table">
							<tr>
								<td class="comparable-stat-card">
									<div class="comparable-stat-label">
										{{ 'comparables.stats.analyzed_sales'|trans({}, 'pdf') }}
									</div>
									<div class="comparable-stat-value">
										{{ comparableStats.count }}
									</div>
								</td>

								<td class="comparable-stat-card">
									<div class="comparable-stat-label">
										{{ 'comparables.stats.average_price_m2'|trans({}, 'pdf') }}
									</div>
									<div class="comparable-stat-value">
										{{ comparableStats.averagePricePerSqm|number_format(0, ',', ' ') }}
										€/m²
									</div>
								</td>

								<td class="comparable-stat-card">
									<div class="comparable-stat-label">
										{{ 'comparables.stats.median_price_m2'|trans({}, 'pdf') }}
									</div>
									<div class="comparable-stat-value">
										{{ comparableStats.medianPricePerSqm|number_format(0, ',', ' ') }}
										€/m²
									</div>
								</td>

								<td class="comparable-stat-card">
									<div class="comparable-stat-label">
										{{ 'comparables.stats.estimate_gap'|trans({}, 'pdf') }}
									</div>
									<div class="comparable-stat-value">
										{% if comparableStats.gapPercent is not null %}
											{{ comparableStats.gapPercent > 0 ? '+' : '' }}{{ comparableStats.gapPercent }}
											%
										{% else %}
											—
										{% endif %}
									</div>
								</td>
							</tr>
						</table>
					{% endif %}

					<table class="comparable-table">
						{% for row in displayedComparables|batch(2) %}
							{% set rowOffset = loop.index0 * 2 %}
							<tr>
								{% for comparable in row %}
									<td class="comparable-card">
										<div class="comparable-label">
											{{ 'comparables.comparable'|trans({}, 'pdf') }}
											{{ rowOffset + loop.index }}
										</div>

										<div class="comparable-type">{{ comparable.type|default(property.type) }}</div>
										<div class="comparable-location">{{ comparable.city|default(property.city)|upper }}</div>

										{% if comparable.address is defined and comparable.address %}
											<div class="comparable-address">{{ comparable.address }}</div>
										{% endif %}

										<div class="comparable-surface">
											{{ comparable.surface|default(property.surface) }}
											m²
										</div>

										<div class="comparable-price">
											{{ comparable.price|default(0)|number_format(0, ',', ' ') }}
											€
										</div>

										{% if comparable.pricePerSqm is defined and comparable.pricePerSqm %}
											<div class="comparable-price-m2">
												{{ comparable.pricePerSqm|number_format(0, ',', ' ') }}
												€/m²
											</div>
										{% endif %}

										{% if comparable.distance is defined and comparable.distance %}
											<div class="comparable-date">Distance :
												{{ comparable.distance }}</div>
										{% endif %}

										{% if comparable.saleDate is defined and comparable.saleDate %}
											<div class="comparable-date">
												Vente :
												{{ comparable.saleDate }}
											</div>
										{% endif %}
									</td>
								{% endfor %}
							</tr>
						{% endfor %}
					</table>

					{% if marketPosition is defined and marketPosition %}
						<div class="market-position-box">
							{{ marketPosition|trans({}, 'pdf') }}
						</div>
					{% endif %}

					<div class="comparable-note">
						{{ 'comparables.note'|trans({}, 'pdf') }}
					</div>
				</div>
			{% endif %}

			<div class="section">
				<div class="strategy-card">
					<div class="strategy-title">{{ 'strategy.title'|trans({}, 'pdf') }}</div>

					<table class="strategy-metrics">
						<tr>
							<td class="strategy-metric">
								<div class="strategy-metric-label">{{ 'strategy.recommended_price'|trans({}, 'pdf') }}</div>
								<div class="strategy-metric-value">
									{{ property.highEstimate ? property.highEstimate|number_format(0, ',', ' ') ~ ' €' : property.estimate|number_format(0, ',', ' ') ~ ' €' }}
								</div>
							</td>

							<td class="strategy-metric">
								<div class="strategy-metric-label">{{ 'strategy.negotiation_threshold'|trans({}, 'pdf') }}</div>
								<div class="strategy-metric-value">
									{{ property.lowEstimate ? property.lowEstimate|number_format(0, ',', ' ') ~ ' €' : property.estimate|number_format(0, ',', ' ') ~ ' €' }}
								</div>
							</td>
						</tr>
					</table>

					{% if sellingStrategy is defined and sellingStrategy is iterable and sellingStrategy is not empty %}
						<ul class="strategy-list">
							{% for item in sellingStrategy %}
								<li>{{ item }}</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>
			</div>

			<div class="section" style="page-break-before: always;">
				<div class="section-title">Plan d’action vendeur</div>

				<table class="property-grid-table">
					<tr>
						<td class="property-card">
							<div class="property-card-label">Étape 1</div>
							<div class="property-card-value">Préparer le bien</div>
							<div class="comparable-note">
								Finaliser les photos, désencombrer les pièces principales et clarifier les points forts à mettre en avant.
							</div>
						</td>

						<td class="property-card">
							<div class="property-card-label">Étape 2</div>
							<div class="property-card-value">Lancer la diffusion</div>
							<div class="comparable-note">
								Publier avec un prix cohérent avec la fourchette haute, puis suivre les retours acheteurs pendant 10 à 15 jours.
							</div>
						</td>
					</tr>

					<tr>
						<td colspan="2" class="property-card property-card-full">
							<div class="property-card-label">Étape 3</div>
							<div class="property-card-value">Ajuster si nécessaire</div>
							<div class="comparable-note">
								Si les contacts sont faibles ou les visites peu qualifiées, réévaluer le positionnement prix à partir de la fourchette basse et des comparables locaux.
							</div>
						</td>
					</tr>
				</table>
			</div>

			{% if (sellingAdvices is defined and sellingAdvices is iterable and sellingAdvices is not empty) or property.adText %}
				<table class="two-column-table">
					<tr>
						{% if sellingAdvices is defined and sellingAdvices is iterable and sellingAdvices is not empty %}
							<td class="two-column-cell">
								<div class="section">
									<div class="section-title">{{ 'advices.title'|trans({}, 'pdf') }}</div>

									<div class="advice-box">
										<ul class="advice-list">
											{% for advice in sellingAdvices %}
												<li>{{ advice }}</li>
											{% endfor %}
										</ul>
									</div>
								</div>
							</td>
						{% endif %}

						{% if property.adText %}
							<td class="two-column-cell">
								<div class="section">
									<div class="section-title">{{ 'ad.title'|trans({}, 'pdf') }}</div>

									<div class="ad-box">
										{{ property.adText|nl2br }}
									</div>
								</div>
							</td>
						{% endif %}
					</tr>
				</table>
			{% endif %}

			<div class="footer">
				{{ 'footer.confidential'|trans({}, 'pdf') }}<br>
				{{ 'footer.non_contractual'|trans({}, 'pdf') }}
				AB-{{ property.id }}-{{ "now"|date('Ymd') }}
			</div>
		</div>
	</body>
</html>
