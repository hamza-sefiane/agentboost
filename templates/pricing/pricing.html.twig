{% extends 'base.html.twig' %}

{% block title %}
	{{ 'pricing.meta.title'|trans }}
{% endblock %}

{% block body %}

	<section class="container py-5 text-center">
		<h1 class="fw-bold mb-3">
			{{ 'pricing.title'|trans }}
		</h1>

		<p class="lead">
			{{ 'pricing.subtitle_line_1'|trans }}<br>
			{{ 'pricing.subtitle_line_2'|trans }}
		</p>
	</section>

	<section class="container py-5">
		<div class="row justify-content-center g-4">

			<div class="col-md-4">
				<div class="card h-100 text-center shadow-sm">
					<div class="card-body p-4">
						<h4 class="mb-3">{{ 'pricing.monthly.title'|trans }}</h4>

						<div class="display-6 fw-bold">29 €</div>

						<p class="text-muted">
							{{ 'pricing.monthly.period'|trans }}
						</p>

						<ul class="list-unstyled my-4">
							<li>✔️
								{{ 'pricing.features.full_access'|trans }}</li>
							<li>✔️
								{{ 'pricing.features.no_commitment'|trans }}</li>
							<li>✔️
								{{ 'pricing.features.cancel_anytime'|trans }}</li>
						</ul>

						{% if app.user and app.user.isActive %}
							<a href="{{ path('dashboard') }}" class="btn btn-outline-secondary w-100">
								{{ 'pricing.actions.dashboard'|trans }}
							</a>
						{% elseif app.user %}
							<button class="btn btn-outline-success w-100" data-plan="monthly">
								{{ 'pricing.actions.choose_monthly'|trans }}
							</button>
						{% else %}
							<a href="{{ path('app_register') }}" class="btn btn-outline-success w-100">
								{{ 'pricing.actions.create_account'|trans }}
							</a>
						{% endif %}
					</div>
				</div>
			</div>

			<div class="col-md-4">
				<div class="card h-100 text-center shadow border-success">
					<div class="card-body p-4">
						<h4 class="mb-3">{{ 'pricing.yearly.title'|trans }}</h4>

						<div class="display-6 fw-bold">290 €</div>

						<p class="text-muted">
							{{ 'pricing.yearly.period'|trans }}<br>
							<small>{{ 'pricing.yearly.discount'|trans }}</small>
						</p>

						<ul class="list-unstyled my-4">
							<li>✔️
								{{ 'pricing.features.full_access'|trans }}</li>
							<li>✔️
								{{ 'pricing.features.instant_saving'|trans }}</li>
							<li>✔️
								{{ 'pricing.features.yearly_billing'|trans }}</li>
						</ul>

						{% if app.user and app.user.isActive %}
							<a href="{{ path('dashboard') }}" class="btn btn-secondary w-100">
								{{ 'pricing.actions.dashboard'|trans }}
							</a>
						{% elseif app.user %}
							<button class="btn btn-success w-100" data-plan="yearly">
								{{ 'pricing.actions.choose_yearly'|trans }}
							</button>
						{% else %}
							<a href="{{ path('app_register') }}" class="btn btn-success w-100">
								{{ 'pricing.actions.create_account'|trans }}
							</a>
						{% endif %}
					</div>
				</div>
			</div>

		</div>
	</section>

	<section class="container py-5 text-center">
		<p class="text-muted">
			{{ 'pricing.footer.line_1'|trans }}<br>
			{{ 'pricing.footer.line_2'|trans }}
		</p>
	</section>

	{% if app.user %} <script src="https://js.stripe.com/v3/"></script>
		 <script>
				const stripe = Stripe("{{ stripe_public_key }}");
		
				document.querySelectorAll('[data-plan]').forEach((button) => {
					button.addEventListener('click', async () => {
						const plan = button.dataset.plan;
		
						try {
							const response = await fetch(`/subscribe/${plan}/checkout`, {
								method: 'POST',
								headers: {
									'Accept': 'application/json'
								}
							});
		
							if (!response.ok) {
								throw new Error('Server error');
							}
		
							const data = await response.json();
		
							if (!data.id) {
								throw new Error('Invalid Stripe session');
							}
		
							await stripe.redirectToCheckout({ sessionId: data.id });
						} catch (error) {
							console.error(error);
							alert('{{ 'pricing.errors.payment'|trans }}');
						}
					});
				});
			</script>
	{% endif %}

{% endblock %}
