{% extends 'base.html.twig' %}

{% block title %}Fonctionnalités – AgentBoost
{% endblock %}

{% block body %}
	<section class="container py-5">

		<h1 class="text-center mb-4">
			Des fonctionnalités pensées pour les agents immobiliers
		</h1>

		<p class="lead text-center mb-5">
			AgentBoost automatise les tâches clés de votre métier pour vous permettre
			        de vous concentrer sur l’essentiel : vendre et accompagner vos clients.
		</p>

		<!-- ESTIMATION -->
		<div class="row align-items-center mb-5">
			<div class="col-md-6">
				<h2>🏡 Estimation automatisée des biens</h2>
				<p>
					Obtenez rapidement une estimation cohérente avec le marché
					                en fonction des caractéristiques du bien.
				</p>
				<ul>
					<li>Gain de temps lors des rendez-vous</li>
					<li>Argumentaire plus crédible face aux vendeurs</li>
					<li>Estimation exploitable immédiatement</li>
				</ul>
			</div>
		</div>

		<!-- GESTION CLIENTS -->
		<div class="row align-items-center mb-5">
			<div class="col-md-6">
				<h2>👥 Gestion des prospects et clients</h2>
				<p>
					Centralisez toutes vos informations dans un tableau de bord unique.
				</p>
				<ul>
					<li>Suivi clair des prospects</li>
					<li>Historique des biens et estimations</li>
					<li>Vision globale de votre activité</li>
				</ul>
			</div>
		</div>

		<!-- IA -->
		<div class="row align-items-center mb-5">
			<div class="col-md-6">
				<h2>✍️ Assistance à la rédaction par IA</h2>
				<p>
					Rédigez plus vite des contenus professionnels adaptés au secteur immobilier.
				</p>
				<ul>
					<li>Annonces immobilières</li>
					<li>Mails clients et prospects</li>
					<li>Descriptions de biens claires et impactantes</li>
				</ul>
			</div>
		</div>

		<!-- ABONNEMENT -->
		<div class="row align-items-center mb-5">
			<div class="col-md-6">
				<h2>💳 Abonnement simple et sécurisé</h2>
				<p>
					Un accès clair et sans friction à la plateforme.
				</p>
				<ul>
					<li>Abonnement mensuel ou annuel</li>
					<li>Paiement sécurisé via Stripe</li>
					<li>Accès activé tant que l’abonnement est valide</li>
				</ul>
			</div>
		</div>

	</section>

	<!-- CTA FINAL -->
	<section class="container text-center py-5 border-top">
		<h2 class="mb-4">
			Prêt à optimiser votre activité immobilière ?
		</h2>

		{% if app.user %}
			<a href="{{ path('dashboard') }}" class="btn btn-success btn-lg">
				Accéder à l’outil
			</a>
		{% else %}
			<a href="{{ path('pricing') }}" class="btn btn-success btn-lg">
				Voir les formules
			</a>
		{% endif %}
	</section>
{% endblock %}
