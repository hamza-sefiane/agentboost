{% extends 'base.html.twig' %}

{% block title %}Contact
{% endblock %}

{% block body %}
	<div class="contact-page">

		<div class="contact-container">

			<div class="contact-header">
				<h1>Contacter AgentBoost</h1>

				<p>
					Une question concernant votre abonnement,
					                un problème technique ou une fonctionnalité ?
					                Notre équipe vous répond rapidement.
				</p>
			</div>

			{% for message in app.flashes('success') %}
				<div class="contact-success">
					{{ message }}
				</div>
			{% endfor %}

			<div class="contact-card">

				{{ form_start(contactForm) }}

				<div class="mb-4">
					{{ form_label(contactForm.name) }}

					{{ form_widget(contactForm.name, {
                        attr: {
                            class: 'form-control',
                            placeholder: 'Votre nom'
                        }
                    }) }}

					{{ form_errors(contactForm.name) }}
				</div>

				<div class="mb-4">
					{{ form_label(contactForm.email) }}

					{{ form_widget(contactForm.email, {
                        attr: {
                            class: 'form-control',
                            placeholder: 'Votre adresse email'
                        }
                    }) }}

					{{ form_errors(contactForm.email) }}
				</div>

				<div class="mb-4">
					{{ form_label(contactForm.subject) }}

					{{ form_widget(contactForm.subject, {
                        attr: {
                            class: 'form-select'
                        }
                    }) }}

					{{ form_errors(contactForm.subject) }}
				</div>

				<div class="mb-4">
					{{ form_label(contactForm.message) }}

					{{ form_widget(contactForm.message, {
                        attr: {
                            class: 'form-control',
                            placeholder: 'Décrivez votre demande...'
                        }
                    }) }}

					{{ form_errors(contactForm.message) }}
				</div>

				<button type="submit" class="contact-submit-btn">
					Envoyer le message
				</button>

				{{ form_end(contactForm) }}

			</div>

		</div>

	</div>
{% endblock %}
