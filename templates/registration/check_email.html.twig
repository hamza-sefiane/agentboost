{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/verify-email.css') }}">
{% endblock %}

{% block body %}
	<div class="container py-5">

		<h1>
			{{ 'verify_email.title'|trans }}
		</h1>

		<p>
			{{ 'verify_email.text.line_1'|trans }}
		</p>

		<p class="text-muted">
			{{ 'verify_email.text.line_2'|trans }}
		</p>

	</div>
{% endblock %}
