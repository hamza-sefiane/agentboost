{% extends 'base.html.twig' %}

{% block title %}
	{{ 'register.meta.title'|trans }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/register.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script type="module" src="{{ asset('js/register.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="auth-page">
		<div class="auth-card">
			<h1 class="auth-title">
				{{ 'register.title'|trans }}
			</h1>

			{% for message in app.flashes('error') %}
				<div class="auth-flash">
					{{ message }}
				</div>
			{% endfor %}

			<form method="post" action="{{ path('app_register') }}" id="registerForm" novalidate>
				<div class="auth-field">
					<label for="email" class="auth-label">
						{{ 'register.form.email'|trans }}
					</label>

					<input type="email" id="email" name="email" class="auth-input" autocomplete="email" required autofocus>

					<div id="emailError" class="auth-error"></div>
				</div>

				<div class="auth-field">
					<label for="password" class="auth-label">
						{{ 'register.form.password'|trans }}
					</label>

					<div class="auth-password-wrapper">
						<input type="password" id="password" name="password" class="auth-input" autocomplete="new-password" required>

						<button type="button" id="togglePassword1" class="auth-toggle-password" aria-label="{{ 'register.form.show_password'|trans }}">
							<svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>

							<svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor" hidden>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18"/>
							</svg>
						</button>
					</div>

					<div class="auth-helper">
						{{ 'register.form.password_helper'|trans }}
					</div>

					<div id="passwordError" class="auth-error"></div>
				</div>

				<div class="auth-field">
					<label for="confirmPassword" class="auth-label">
						{{ 'register.form.confirm_password'|trans }}
					</label>

					<div class="auth-password-wrapper">
						<input type="password" id="confirmPassword" name="confirm_password" class="auth-input" autocomplete="new-password" required>

						<button type="button" id="togglePassword2" class="auth-toggle-password" aria-label="{{ 'register.form.show_password'|trans }}">
							<svg id="confirmEyeOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>

							<svg id="confirmEyeClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor" hidden>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18"/>
							</svg>
						</button>
					</div>

					<div class="auth-helper">
						{{ 'register.form.confirm_password_helper'|trans }}
					</div>

					<div id="confirmPasswordError" class="auth-error"></div>
				</div>

				<button type="submit" class="auth-submit" id="submitButton">
					{{ 'register.form.submit'|trans }}
				</button>
			</form>

			<div class="auth-footer">
				{{ 'register.footer.already_registered'|trans }}
				<a href="{{ path('app_login') }}">
					{{ 'register.footer.login'|trans }}
				</a>
			</div>
		</div>
	</div>
{% endblock %}
