{% extends 'base.html.twig' %}

{% block title %}S'inscrire
{% endblock %}

{% block body %}
	<div class="auth-page">
		<div class="auth-card">
			<h1 class="auth-title">Inscription</h1>

			{% for message in app.flashes('error') %}
				<div class="auth-flash">
					{{ message }}
				</div>
			{% endfor %}

			<form method="POST" action="{{ path('app_register') }}" id="registerForm" novalidate>

				<div class="auth-field">
					<label for="email" class="auth-label">Email</label>

					<input type="email" id="email" name="email" class="auth-input" autocomplete="email" required autofocus>

					<div id="emailError" class="auth-error"></div>
				</div>

				<div class="auth-field">
					<label for="password" class="auth-label">Mot de passe</label>

					<div class="auth-password-wrapper">
						<input type="password" id="password" name="password" class="auth-input" autocomplete="new-password" required>

						<button type="button" id="togglePassword1" class="auth-toggle-password" aria-label="Afficher le mot de passe">
							<svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>

							<svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor" style="display:none;">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18"/>
							</svg>
						</button>
					</div>

					<div class="auth-helper">
						Minimum 8 caractères
					</div>

					<div id="passwordError" class="auth-error"></div>
				</div>

				<div class="auth-field">
					<label for="confirmPassword" class="auth-label">
						Confirmer le mot de passe
					</label>

					<div class="auth-password-wrapper">
						<input type="password" id="confirmPassword" name="confirm_password" class="auth-input" autocomplete="new-password" required>

						<button type="button" id="togglePassword2" class="auth-toggle-password" aria-label="Afficher le mot de passe">
							<svg id="confirmEyeOpen" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
							</svg>

							<svg id="confirmEyeClosed" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor" style="display:none;">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l18 18"/>
							</svg>
						</button>
					</div>

					<div class="auth-helper">
						Retapez votre mot de passe
					</div>

					<div id="confirmPasswordError" class="auth-error"></div>
				</div>

				<button type="submit" class="auth-submit" id="submitButton">
					Créer mon compte
				</button>
			</form>

			<div class="auth-footer">
				Déjà inscrit ?
				<a href="{{ path('app_login') }}">Se connecter</a>
			</div>
		</div>
	</div>
{% endblock %}
