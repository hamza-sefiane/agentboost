{% extends 'base.html.twig' %}

{% block title %}
	{{ 'forgot_password.meta.title'|trans }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<h1 class="auth-title">
				{{ 'forgot_password.title'|trans }}
			</h1>

			{% for flash_error in app.flashes('reset_password_error') %}
				<div class="auth-error">
					{{ flash_error }}
				</div>
			{% endfor %}

			<p class="auth-helper text-center mb-4">
				{{ 'forgot_password.helper'|trans }}
			</p>

			{{ form_start(requestForm, {
				attr: {
					class: 'auth-form'
				}
			}) }}

			<div class="auth-field">

				{{ form_label(requestForm.email, 'forgot_password.form.email'|trans, {
					label_attr: {
						class: 'auth-label'
					}
				}) }}

				{{ form_widget(requestForm.email, {
					attr: {
						class: 'auth-input',
						autocomplete: 'email'
					}
				}) }}

				{{ form_errors(requestForm.email) }}

			</div>

			<button type="submit" class="auth-submit">
				{{ 'forgot_password.form.submit'|trans }}
			</button>

			{{ form_end(requestForm) }}

			<div class="auth-link">
				<a href="{{ path('app_login') }}">
					{{ 'forgot_password.back_login'|trans }}
				</a>
			</div>

		</div>
	</div>
{% endblock %}
