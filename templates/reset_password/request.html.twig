{% extends 'base.html.twig' %}

{% block title %}
	{{ 'meta.title'|trans({}, 'reset_password') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<h1 class="auth-title">
				{{ 'title'|trans({}, 'reset_password') }}
			</h1>

			{% for flash_error in app.flashes('reset_password_error') %}
				<div class="auth-error">
					{{ flash_error }}
				</div>
			{% endfor %}

			<p class="auth-helper text-center mb-4">
				{{ 'helper'|trans({}, 'reset_password') }}
			</p>

			{{ form_start(requestForm, {
                attr: {
                    class: 'auth-form'
                }
            }) }}

			<div class="auth-field">
				{{ form_label(requestForm.email, 'form.email'|trans({}, 'reset_password'), {
                    label_attr: {
                        class: 'auth-label'
                    }
                }) }}

				{{ form_widget(requestForm.email, {
                    attr: {
                        class: 'auth-input',
                        autocomplete: 'email'
                    }
                }) }}

				{{ form_errors(requestForm.email) }}
			</div>

			<button type="submit" class="auth-submit">
				{{ 'form.submit'|trans({}, 'reset_password') }}
			</button>

			{{ form_end(requestForm) }}

			<div class="auth-link">
				<a href="{{ path('app_login') }}">
					{{ 'back_login'|trans({}, 'reset_password') }}
				</a>
			</div>

		</div>
	</div>
{% endblock %}
