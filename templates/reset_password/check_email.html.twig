{% extends 'base.html.twig' %}

{% block title %}Email envoyé
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">
			<div class="auth-badge">✓</div>

			<h1 class="auth-title">Email envoyé</h1>

			<p class="auth-text">
				Si un compte correspond à cette adresse email, un lien de réinitialisation vient d’être envoyé.
								                Ce lien expirera dans
				{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
			</p>

			<p class="auth-text mt-3">
				Pensez à vérifier vos courriers indésirables.
			</p>

			<div class="auth-actions">
				<a href="{{ path('app_forgot_password_request') }}" class="btn btn-outline-success">
					Renvoyer un lien
				</a>

				<a href="{{ path('app_login') }}" class="btn btn-success">
					Retour connexion
				</a>
			</div>
		</div>
	</div>
{% endblock %}
