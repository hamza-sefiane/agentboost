{% extends 'base.html.twig' %}

{% block title %}
	{{ 'sent.meta.title'|trans({}, 'reset_password') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<div class="auth-badge">
				✓
			</div>

			<h1 class="auth-title">
				{{ 'sent.title'|trans({}, 'reset_password') }}
			</h1>

			<p class="auth-text">
				{{ 'sent.text.line_1'|trans({}, 'reset_password') }}

				{{ resetToken.expirationMessageKey|trans(
                    resetToken.expirationMessageData,
                    'ResetPasswordBundle'
                ) }}.
			</p>

			<p class="auth-text mt-3">
				{{ 'sent.text.line_2'|trans({}, 'reset_password') }}
			</p>

			<div class="auth-actions">

				<a href="{{ path('app_forgot_password_request') }}" class="btn btn-outline-success">
					{{ 'sent.actions.resend'|trans({}, 'reset_password') }}
				</a>

				<a href="{{ path('app_login') }}" class="btn btn-success">
					{{ 'sent.actions.back_login'|trans({}, 'reset_password') }}
				</a>

			</div>

		</div>
	</div>
{% endblock %}
