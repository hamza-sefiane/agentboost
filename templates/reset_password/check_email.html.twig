{% extends 'base.html.twig' %}

{% block title %}
	{{ 'reset_password.sent.meta.title'|trans }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<div class="auth-badge">
				✓
			</div>

			<h1 class="auth-title">
				{{ 'reset_password.sent.title'|trans }}
			</h1>

			<p class="auth-text">
				{{ 'reset_password.sent.text.line_1'|trans }}

				{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
			</p>

			<p class="auth-text mt-3">
				{{ 'reset_password.sent.text.line_2'|trans }}
			</p>

			<div class="auth-actions">

				<a href="{{ path('app_forgot_password_request') }}" class="btn btn-outline-success">
					{{ 'reset_password.sent.actions.resend'|trans }}
				</a>

				<a href="{{ path('app_login') }}" class="btn btn-success">
					{{ 'reset_password.sent.actions.back_login'|trans }}
				</a>

			</div>

		</div>
	</div>
{% endblock %}
