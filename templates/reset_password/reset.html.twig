{% extends 'base.html.twig' %}

{% block title %}
	{{ 'new.meta.title'|trans({}, 'reset_password') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script type="module" src="{{ asset('js/reset-password.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<div class="auth-badge">
				🔒
			</div>

			<h1 class="auth-title">
				{{ 'new.title'|trans({}, 'reset_password') }}
			</h1>

			<p class="auth-subtitle">
				{{ 'new.subtitle'|trans({}, 'reset_password') }}
			</p>

			{{ form_start(resetForm, {
                attr: {
                    class: 'auth-form'
                }
            }) }}

			{{ form_errors(resetForm) }}

			<div class="auth-field">
				<label class="auth-label">
					{{ 'new.form.password'|trans({}, 'reset_password') }}
				</label>

				<div class="password-wrapper">
					{{ form_widget(resetForm.plainPassword.first, {
                        attr: {
                            autocomplete: 'new-password',
                            class: 'password-input js-password-input',
                            placeholder: 'new.form.password_placeholder'|trans({}, 'reset_password')
                        }
                    }) }}

					<button type="button" class="password-toggle" aria-label="{{ 'new.form.show_password'|trans({}, 'reset_password') }}">
						<i class="bi bi-eye"></i>
					</button>
				</div>

				<div class="password-strength">
					<span></span>
					<span></span>
					<span></span>
					<span></span>
				</div>

				<div class="password-strength-label" id="password-strength-label">
					{{ 'new.form.password_strength'|trans({}, 'reset_password') }}
				</div>

				<div class="auth-errors">
					{{ form_errors(resetForm.plainPassword.first) }}
				</div>
			</div>

			<div class="auth-field">
				<label class="auth-label">
					{{ 'new.form.confirm_password'|trans({}, 'reset_password') }}
				</label>

				<div class="password-wrapper">
					{{ form_widget(resetForm.plainPassword.second, {
                        attr: {
                            autocomplete: 'new-password',
                            class: 'password-input',
                            placeholder: 'new.form.confirm_password_placeholder'|trans({}, 'reset_password')
                        }
                    }) }}

					<button type="button" class="password-toggle" aria-label="{{ 'new.form.show_password'|trans({}, 'reset_password') }}">
						<i class="bi bi-eye"></i>
					</button>
				</div>

				<div class="auth-errors">
					{{ form_errors(resetForm.plainPassword.second) }}
				</div>
			</div>

			<button type="submit" class="auth-submit">
				{{ 'new.form.submit'|trans({}, 'reset_password') }}
			</button>

			{{ form_end(resetForm) }}

			<a href="{{ path('app_login') }}" class="auth-back">
				←
				{{ 'new.back_login'|trans({}, 'reset_password') }}
			</a>

		</div>
	</div>
{% endblock %}
