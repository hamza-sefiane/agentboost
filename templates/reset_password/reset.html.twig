{% extends 'base.html.twig' %}

{% block title %}
	Nouveau mot de passe
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script type="module" src="{{ asset('js/reset-password.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">
			<div class="auth-badge">🔒</div>

			<h1 class="auth-title">Nouveau mot de passe</h1>

			<p class="auth-subtitle">
				Choisissez un nouveau mot de passe sécurisé pour votre compte AgentBoost.
			</p>

			{{ form_start(resetForm, {
				attr: {
					class: 'auth-form'
				}
			}) }}

			{{ form_errors(resetForm) }}

			<div class="auth-field">
				<label class="auth-label">
					Nouveau mot de passe
				</label>

				<div class="password-wrapper">
					{{ form_widget(resetForm.plainPassword.first, {
						attr: {
							autocomplete: 'new-password',
							class: 'password-input js-password-input',
							placeholder: 'Votre nouveau mot de passe'
						}
					}) }}

					<button type="button" class="password-toggle" aria-label="Afficher le mot de passe">
						<i class="bi bi-eye"></i>
					</button>
				</div>

				<div class="password-strength">
					<span></span>
					<span></span>
					<span></span>
					<span></span>
				</div>

				<div class="password-strength-label" id="password-strength-label">
					Sécurité du mot de passe
				</div>

				<div class="auth-errors">
					{{ form_errors(resetForm.plainPassword.first) }}
				</div>
			</div>

			<div class="auth-field">
				<label class="auth-label">
					Confirmer le nouveau mot de passe
				</label>

				<div class="password-wrapper">
					{{ form_widget(resetForm.plainPassword.second, {
						attr: {
							autocomplete: 'new-password',
							class: 'password-input',
							placeholder: 'Confirmez le mot de passe'
						}
					}) }}

					<button type="button" class="password-toggle" aria-label="Afficher le mot de passe">
						<i class="bi bi-eye"></i>
					</button>
				</div>

				<div class="auth-errors">
					{{ form_errors(resetForm.plainPassword.second) }}
				</div>
			</div>

			<button type="submit" class="auth-submit">
				Réinitialiser le mot de passe
			</button>

			{{ form_end(resetForm) }}

			<a href="{{ path('app_login') }}" class="auth-back">
				← Retour à la connexion
			</a>
		</div>
	</div>
{% endblock %}
