{% extends 'base.html.twig' %}

{% block title %}
	{{ 'reset_password.new.meta.title'|trans }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	 <script type="module" src="{{ asset('js/reset-password.js') }}"></script>
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-card">

			<div class="auth-badge">
				🔒
			</div>

			<h1 class="auth-title">
				{{ 'reset_password.new.title'|trans }}
			</h1>

			<p class="auth-subtitle">
				{{ 'reset_password.new.subtitle'|trans }}
			</p>

			{{ form_start(resetForm, {
				attr: {
					class: 'auth-form'
				}
			}) }}

			{{ form_errors(resetForm) }}

			<div class="auth-field">

				<label class="auth-label">
					{{ 'reset_password.new.form.password'|trans }}
				</label>

				<div class="password-wrapper">

					{{ form_widget(resetForm.plainPassword.first, {
						attr: {
							autocomplete: 'new-password',
							class: 'password-input js-password-input',
							placeholder: 'reset_password.new.form.password_placeholder'|trans
						}
					}) }}

					<button type="button" class="password-toggle" aria-label="{{ 'reset_password.new.form.show_password'|trans }}">
						<i class="bi bi-eye"></i>
					</button>

				</div>

				<div class="password-strength">
					<span></span>
					<span></span>
					<span></span>
					<span></span>
				</div>

				<div class="password-strength-label" id="password-strength-label">
					{{ 'reset_password.new.form.password_strength'|trans }}
				</div>

				<div class="auth-errors">
					{{ form_errors(resetForm.plainPassword.first) }}
				</div>

			</div>

			<div class="auth-field">

				<label class="auth-label">
					{{ 'reset_password.new.form.confirm_password'|trans }}
				</label>

				<div class="password-wrapper">

					{{ form_widget(resetForm.plainPassword.second, {
						attr: {
							autocomplete: 'new-password',
							class: 'password-input',
							placeholder: 'reset_password.new.form.confirm_password_placeholder'|trans
						}
					}) }}

					<button type="button" class="password-toggle" aria-label="{{ 'reset_password.new.form.show_password'|trans }}">
						<i class="bi bi-eye"></i>
					</button>

				</div>

				<div class="auth-errors">
					{{ form_errors(resetForm.plainPassword.second) }}
				</div>

			</div>

			<button type="submit" class="auth-submit">
				{{ 'reset_password.new.form.submit'|trans }}
			</button>

			{{ form_end(resetForm) }}

			<a href="{{ path('app_login') }}" class="auth-back">
				←
				{{ 'reset_password.new.back_login'|trans }}
			</a>

		</div>
	</div>
{% endblock %}
