<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}AgentBoost
			{% endblock %}
		</title>

		<link rel="icon" href="{{ asset('favicon.ico') }}">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

		{{ importmap('app') }}

		{% block stylesheets %}{% endblock %}
	</head>

	<body>
		{% set languages = {
			'fr': {'flag': 'https://flagcdn.com/fr.svg', 'label': 'Français'},
			'en': {'flag': 'https://flagcdn.com/gb.svg', 'label': 'English'},
			'es': {'flag': 'https://flagcdn.com/es.svg', 'label': 'Español'}
		} %}

		{% set currentLocale = app.request.locale|default('fr') %}

		<nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
			<div class="container-fluid px-3 px-lg-4">

				<a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('home') }}">
					<span class="brand-logo">⌂</span>
					<span>AgentBoost</span>
				</a>

				<button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Menu">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarNav">

					{% if app.user and is_granted('ACCESS_DASHBOARD') %}

						<ul class="navbar-nav align-items-lg-center gap-lg-2 ms-lg-4">
							<li class="nav-item">
								<a class="nav-link {{ app.request.attributes.get('_route') == 'dashboard' ? 'active' : '' }}" href="{{ path('dashboard') }}">
									{{ 'navbar.dashboard'|trans }}
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="#properties-section">
									{{ 'navbar.properties'|trans }}
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="#">
									{{ 'navbar.listings'|trans }}
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="#">
									{{ 'navbar.documents'|trans }}
								</a>
							</li>
						</ul>

						<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
							<li class="nav-item">
								<span class="user-badge">
									{{ app.user.userIdentifier }}
								</span>
							</li>

							<li class="nav-item dropdown">
								{% set unreadNotifications = notification_count() %}
								{% set notifications = latest_notifications(5) %}

								<button class="notification-btn position-relative" type="button" data-bs-toggle="dropdown" data-notification-read-url="{{ path('notifications_read_all') }}" aria-expanded="false" aria-label="Notifications">
									🔔

									{% if unreadNotifications > 0 %}
										<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
											{{ unreadNotifications > 99 ? '99+' : unreadNotifications }}
										</span>
									{% endif %}
								</button>

								<ul class="dropdown-menu dropdown-menu-end shadow border-0" style="width: 380px; max-width: 95vw;">
									<li class="dropdown-header fw-bold">
										Notifications
									</li>

									{% if notifications is empty %}
										<li>
											<span class="dropdown-item-text text-muted">
												Aucune notification
											</span>
										</li>
									{% else %}
										{% for notification in notifications %}
											<li>
												<div class="dropdown-item-text py-2">
													<div class="fw-bold">
														{{ notification.title }}
													</div>

													<div class="small text-muted">
														{{ notification.message }}
													</div>

													<div class="small text-secondary mt-1">
														{{ notification.createdAt|date('d/m/Y H:i') }}
													</div>
												</div>
											</li>

											{% if not loop.last %}
												<li><hr class="dropdown-divider"></li>
											{% endif %}
										{% endfor %}
									{% endif %}

									<li><hr class="dropdown-divider"></li>

									<li>
										<a href="{{ path('notifications_index') }}" class="dropdown-item text-center fw-semibold">
											Voir toutes les notifications
										</a>
									</li>

								</ul>
							</li>

							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<img src="{{ languages[currentLocale].flag }}" alt="{{ languages[currentLocale].label }}" width="20" height="14">
									<span>{{ languages[currentLocale].label }}</span>
								</a>

								<ul class="dropdown-menu dropdown-menu-end">
									{% for code, language in languages %}
										<li>
											<a class="dropdown-item d-flex align-items-center gap-2 {{ currentLocale == code ? 'active' : '' }}" href="{{ path('change_locale', { locale: code }) }}">
												<img src="{{ language.flag }}" alt="{{ language.label }}" width="20" height="14">
												<span>{{ language.label }}</span>
											</a>
										</li>
									{% endfor %}
								</ul>
							</li>

							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
									{{ 'navbar.account'|trans }}
								</a>

								<ul class="dropdown-menu dropdown-menu-end">
									<li>
										<a class="dropdown-item" href="{{ path('company_profile') }}">
											{{ 'navbar.company_profile'|trans }}
										</a>
									</li>

									<li>
										<a class="dropdown-item" href="{{ path('subscription_manage') }}">
											{{ 'navbar.subscription_manage'|trans }}
										</a>
									</li>
									{% if is_granted('ROLE_ADMIN') %}
										<li><hr class="dropdown-divider"></li>

										<li>
											<a class="dropdown-item" href="{{ path('admin_stats') }}">
												Admin stats
											</a>
										</li>

										<li>
											<a class="dropdown-item" href="{{ path('admin_users') }}">
												Admin users
											</a>
										</li>

										<li>
											<a class="dropdown-item" href="{{ path('admin_logs') }}">
												Admin logs
											</a>
										</li>
									{% endif %}

									<li><hr class="dropdown-divider"></li>

									<li>
										<form method="post" action="{{ path('account_delete') }}" data-turbo="false" onsubmit="return confirm('{{ 'navbar.delete_account_confirm'|trans|e('js') }}');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">

											<button class="dropdown-item text-danger" type="submit">
												{{ 'navbar.delete_account'|trans }}
											</button>
										</form>
									</li>

									<li>
										<form method="post" action="{{ path('app_logout') }}" data-turbo="false">
											<input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">

											<button type="submit" class="dropdown-item">
												{{ 'navbar.logout'|trans }}
											</button>
										</form>
									</li>
								</ul>
							</li>
						</ul>

					{% else %}

						<ul class="navbar-nav ms-auto align-items-center gap-2">
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
									<img src="{{ languages[currentLocale].flag }}" alt="{{ languages[currentLocale].label }}" width="20" height="14">
									<span>{{ languages[currentLocale].label }}</span>
								</a>

								<ul class="dropdown-menu dropdown-menu-end">
									{% for code, language in languages %}
										<li>
											<a class="dropdown-item d-flex align-items-center gap-2 {{ currentLocale == code ? 'active' : '' }}" href="{{ path('change_locale', { locale: code }) }}">
												<img src="{{ language.flag }}" alt="{{ language.label }}" width="20" height="14">
												<span>{{ language.label }}</span>
											</a>
										</li>
									{% endfor %}
								</ul>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="{{ path('pricing') }}">
									{{ 'navbar.pricing'|trans }}
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_login') }}">
									{{ 'navbar.login'|trans }}
								</a>
							</li>

							<li class="nav-item">
								<a class="btn btn-sm btn-success" href="{{ path('app_register') }}">
									{{ 'navbar.register'|trans }}
								</a>
							</li>
						</ul>

					{% endif %}
				</div>
			</div>
		</nav>

		<main class="container my-4">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert alert-{{ label == 'error' ? 'danger' : label }} mt-3">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			{% block body %}{% endblock %}
		</main>

		<footer class="footer-custom">
			<div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
				<div>
					&copy;
					{{ "now"|date("Y") }}
					AgentBoost —
					{{ 'footer.rights'|trans }}
				</div>

				<div class="d-flex gap-3 small">
					<a href="{{ path('legal_cgu') }}">CGU</a>
					<a href="#">{{ 'footer.privacy'|trans }}</a>
					<a href="{{ path('app_contact') }}">{{ 'footer.contact'|trans }}</a>
				</div>
			</div>
		</footer>

		 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

		 <script>
						document.addEventListener('DOMContentLoaded', () => {
						    const notificationButton = document.querySelector('[data-notification-read-url]');
						
						    if (!notificationButton) {
						        return;
						    }
						
						    const dropdown = notificationButton.closest('.dropdown');
						
						    if (!dropdown) {
						        return;
						    }
						
						    dropdown.addEventListener('shown.bs.dropdown', async () => {
						        const url = notificationButton.dataset.notificationReadUrl;
						
						        if (!url) {
						            return;
						        }
						
						        try {
						            await fetch(url, {
						                method: 'POST',
						                headers: {
						                    'X-Requested-With': 'XMLHttpRequest'
						                }
						            });
						
						            const badge = notificationButton.querySelector('.badge');
						
						            if (badge) {
						                badge.remove();
						            }
						        } catch (error) {
						            console.error('Notification read error', error);
						        }
						    });
						});
						</script>

		{% block javascripts %}{% endblock %}
	</body>
</html>
