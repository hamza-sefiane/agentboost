<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			{% block title %}AgentBoost
			{% endblock %}
		</title>

		<link rel="icon" href="{{ asset('favicon.ico') }}">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

		{{ importmap('app') }}

		{% block stylesheets %}{% endblock %}

	</head>

	<body>
		<nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
			<div class="container-fluid px-3 px-lg-4">

				<a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('home') }}">
					<span class="brand-logo">⌂</span>
					<span>AgentBoost</span>
				</a>

				<button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarNav">

					{% if app.user and is_granted('ACCESS_DASHBOARD') %}

						<ul class="navbar-nav align-items-lg-center gap-lg-2 ms-lg-4">
							<li class="nav-item">
								<a class="nav-link {{ app.request.attributes.get('_route') == 'dashboard' ? 'active' : '' }}" href="{{ path('dashboard') }}">
									Dashboard
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="#properties-section">
									Biens estimés
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="#">
									Annonces
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="#">
									Documents
								</a>
							</li>
						</ul>

						<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

							<li class="nav-item">
								<span class="user-badge">
									{{ app.user.userIdentifier }}
								</span>
							</li>

							<li class="nav-item">
								<button class="notification-btn" type="button">
									🔔
								</button>
							</li>

							<li class="nav-item dropdown language-dropdown">
								<a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
									<span class="language-dot"></span>
									Français
								</a>

								<ul class="dropdown-menu dropdown-menu-end">
									<li>
										<a class="dropdown-item active" href="#">
											Français
										</a>
									</li>

									<li>
										<a class="dropdown-item" href="#">
											English
										</a>
									</li>

									<li>
										<a class="dropdown-item" href="#">
											Español
										</a>
									</li>
								</ul>
							</li>

							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
									Mon compte
								</a>

								<ul class="dropdown-menu dropdown-menu-end">
									<li>
										<a class="dropdown-item" href="{{ path('company_profile') }}">
											Modifier mes coordonnées
										</a>
									</li>

									<li>
										<a class="dropdown-item" href="{{ path('subscription_manage') }}">
											Gérer mon abonnement
										</a>
									</li>

									<li><hr class="dropdown-divider"></li>

									<li>
										<form method="post" action="{{ path('account_delete') }}" data-turbo="false" onsubmit="return confirm('Supprimer définitivement votre compte ?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">

											<button class="dropdown-item text-danger" type="submit">
												Supprimer mon compte
											</button>
										</form>
									</li>

									<li>
										<form method="post" action="{{ path('app_logout') }}" data-turbo="false">
											<input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">

											<button type="submit" class="dropdown-item">
												Déconnexion
											</button>
										</form>
									</li>

								</ul>
							</li>
						</ul>

					{% else %}

						<ul class="navbar-nav ms-auto align-items-center gap-2">
							<li class="nav-item">
								<a class="nav-link" href="{{ path('pricing') }}">
									Tarifs
								</a>
							</li>

							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_login') }}">
									Connexion
								</a>
							</li>

							<li class="nav-item">
								<a class="btn btn-sm btn-success" href="{{ path('app_register') }}">
									Inscription
								</a>
							</li>
						</ul>

					{% endif %}
				</div>
			</div>
		</nav>

		<main class="container my-4">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="alert alert-{{ label == 'error' ? 'danger' : label }} mt-3">
						{{ message }}
					</div>
				{% endfor %}
			{% endfor %}

			{% block body %}{% endblock %}
		</main>

		<footer class="footer-custom">
			<div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
				<div>
					&copy;
					{{ "now"|date("Y") }}
					AgentBoost — Tous droits réservés
				</div>

				<div class="d-flex gap-3 small">
					<a href="{{ path('legal_cgu') }}">CGU</a>
					<a href="#">Confidentialité</a>
					<a href="{{ path('app_contact') }}">Contact</a>
				</div>
			</div>
		</footer>

		 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
		{% block javascripts %}{% endblock %}

	</body>
</html>
